#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpIngameVotePlayers"

// Macros //

#include "ui/modern_widgets.h"

// Players Vote Menu //

menuDef {
	name		"ingame_vote_players"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onEsc {
		close ingame_vote_players ;
		open ingame_vote
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}
// Window //

	WINDOW( "Misc. Player", 50)
    itemDef {
        name "modern_secondary_0"
        rect 24 60 542 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }

    itemDef {
        name "modern_secondary_1"
        rect 590 60 238 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }


// Map Selection //
	
	itemDef {
		name			"playerList"
		group			GROUP_NAME
		rect			36 76 518 340
		type			ITEM_TYPE_LISTBOX
		textfont		UI_FONT_COURBD_21
		textscale		.28
		textaligny		-2
		forecolor		.88 .91 .94 1
		outlinecolor	.94 .75 .27 .20
		border			WINDOW_BORDER_FULL
		bordercolor		.23 .29 .35 .75
		feeder			FEEDER_PLAYER_LIST
		elementtype		LISTBOX_TEXT
		elementwidth	502
		elementheight	26
		columns			1 0 502 33
		visible			1
		backcolor	.055 .075 .10 .94
	}

// Buttons //

	BUTTONEXT( 606, 78, 206, 32, "KICK", .27, 22, uiScript voteKick ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_NONE } voteFlag CV_SVF_KICK )
	BUTTONEXT( 606, 78, 206, 32, "KICK", .27, 22, uiScript refKick ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 606, 78, 206, 32, "KICK", .27, 22, uiScript rconKick ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_RCON } )
	BUTTONEXT( 606, 120, 206, 32, "MUTE", .27, 22, uiScript voteMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOTMUTED cvarTest "authLevel" showCVar { RL_NONE } voteFlag CV_SVF_MUTING )
	BUTTONEXT( 606, 120, 206, 32, "MUTE", .27, 22, uiScript refMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOTMUTED cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 606, 120, 206, 32, "MUTE", .27, 22, uiScript rconMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOTMUTED cvarTest "authLevel" showCVar { RL_RCON } voteFlag CV_SVF_MUTING )
	BUTTONEXT( 606, 120, 206, 32, "UN-MUTE", .27, 22, uiScript voteUnMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERMUTED cvarTest "authLevel" showCVar { RL_NONE } )
	BUTTONEXT( 606, 120, 206, 32, "UN-MUTE", .27, 22, uiScript refUnMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERMUTED cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 606, 120, 206, 32, "UN-MUTE", .27, 22, uiScript rconUnMute ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERMUTED cvarTest "authLevel" showCVar { RL_RCON } )

	BUTTONEXT( 606, 162, 206, 32, "MAKE REFEREE", .27, 22, uiScript voteReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOREFEREE cvarTest "authLevel" showCVar { RL_NONE } voteFlag CV_SVF_REFEREE )
	BUTTONEXT( 606, 162, 206, 32, "MAKE REFEREE", .27, 22, uiScript voteReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOREFEREE cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 606, 162, 206, 32, "MAKE REFEREE", .27, 22, uiScript rconMakeReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERNOREFEREE cvarTest "authLevel" showCVar { RL_RCON } )
	BUTTONEXT( 606, 162, 206, 32, "UN-REFEREE", .27, 22, uiScript voteUnReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERREFEREE cvarTest "authLevel" showCVar { RL_NONE } voteFlag CV_SVF_REFEREE )
	BUTTONEXT( 606, 162, 206, 32, "UN-REFEREE", .27, 22, uiScript voteUnReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERREFEREE cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 606, 162, 206, 32, "UN-REFEREE", .27, 22, uiScript rconRemoveReferee ; uiScript closeingame, ownerdrawFlag UI_SHOW_PLAYERREFEREE cvarTest "authLevel" showCVar { RL_RCON } )
	
	BUTTONEXT( 606, 204, 206, 32, "MAKE AXIS", .27, 22, uiScript refMakeAxis ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 606, 246, 206, 32, "MAKE ALLIED", .27, 22, uiScript refMakeAllied ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 606, 288, 206, 32, "MAKE SPEC", .27, 22, uiScript refMakeSpec ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	
	BUTTONEXT( 606, 330, 206, 32, "WARN", .27, 22, open ingame_vote_players_warn, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 606, 372, 206, 32, "BAN", .27, 22, uiScript rconBan ; uiScript closeingame, cvarTest "authLevel" showCVar { RL_RCON } )

	BUTTON( 24, 442, 184, 28, "BACK", .28, 19, close ingame_vote_players ; open ingame_vote )

itemDef { name "modern_vote_nav_misc_0" rect 398 12 138 30
                text "MISC" textfont UI_FONT_ARIBLK_27 textscale .25
                textalign ITEM_ALIGN_CENTER textalignx 69 textaligny 21
                style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL
                bordercolor .23 .29 .35 .75
                backcolor .08 .12 .16 1
                forecolor .84 .89 .94 1
                visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_vote_nav_misc_0" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_misc_0" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_misc_0" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_vote_nav_misc_0" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_misc_0" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_misc_0" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_vote_nav_misc_0" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_misc_0" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_misc_0" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_vote_nav_misc_0" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_misc_0" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_misc_0" bordercolor .23 .29 .35 .75 ; }
 action { close ingame_vote_players ; open ingame_vote ; close ingame_vote ; open ingame_vote_misc }
cvarTest "authLevel" showCVar { RL_NONE }
            }
