#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 104
#define GROUP_NAME		"grpIngameMain"

// Macros //

#include "ui/modern_widgets.h"

// Main Menu //

menuDef {
	name		"ingame_main"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onOpen {
		// ydnar
		conditionalscript ROldModeCheck 2
			( "clearFocus ; open vid_confirm" )
			( "clearFocus" )
	}
	
	onEsc {
		close ingame_main ;
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 104
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}
// Window //

	WINDOW( "Main Menu", 50 )
	
// Buttons //

	BUTTON( 24, 56, 94, 32, "Deployment", .24, 21, clearFocus ; close ingame_main ; exec OpenLimboMenu ; )


	BUTTONEXT( 125, 56, 94, 32, "Vote", .24, 21, uiScript clientCheckVote ; 
															conditionalScript cg_ui_novote 0
																( "clearFocus ; open ingame_votedisabled" )
																( "close ingame_main ; open ingame_vote" ), cvarTest "authLevel" showCVar { RL_NONE } )
	BUTTONEXT( 125, 56, 94, 32, "Referee", .24, 21, close ingame_main ; open ingame_vote, cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 125, 56, 94, 32, "RCON", .24, 21, close ingame_main ; open ingame_vote, cvarTest "authLevel" showCVar { RL_RCON } )
	
	BUTTON( 226, 56, 94, 32, "Server Info", .24, 21, close ingame_main ; open ingame_serverinfo )
	BUTTON( 327, 56, 94, 32, "Options", .24, 21, close ingame_main ; open options )
	BUTTON( 428, 56, 94, 32, "Scoreboard", .24, 21, clearFocus ; close ingame_main ; exec toggleScoreboard ; )
	BUTTON( 529, 56, 94, 32, "Minimize", .24, 21, clearFocus ; exec tce_minimize ; )
	BUTTON( 630, 56, 94, 32, "Disconnect", .24, 21, clearFocus ; open ingame_disconnect )
	BUTTON( 731, 56, 94, 32, "Exit TC:E", .24, 21, clearFocus ; open quit )
}
