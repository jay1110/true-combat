// Original TCE2 UI. Native alpha blending; forecolor/backcolor should be white.

tce2_ui/background
{
	nopicmip
	nomipmaps
	nocompress
	{
		clampmap tce2_ui/background.tga
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen vertex
		alphaGen vertex
	}
}

