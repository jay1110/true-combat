#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpOptionsCustomiseHud"

// Macros //

#include "ui/modern_widgets.h"

// Customise Hud Menu //

menuDef {
	name		"options_customise_hud"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onESC {
		close options_customise_hud ;
		open options
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.025 .035 .05 .97
		visible		1
		decoration
	}
// Window //

	WINDOW( "View", 94 )
// modern settings desktop v1
    itemDef {
        name "modern_settings_card_0"
        rect 24 60 384 352
        style WINDOW_STYLE_FILLED
        backcolor .045 .065 .085 .98
        visible 1
        decoration
    }
    itemDef {
        name "modern_settings_accent_0"
        rect 24 60 3 16
        style WINDOW_STYLE_FILLED
        backcolor .94 .75 .27 .95
        visible 1
        decoration
    }
    itemDef {
        name "modern_settings_card_1"
        rect 444 60 384 294
        style WINDOW_STYLE_FILLED
        backcolor .045 .065 .085 .98
        visible 1
        decoration
    }
    itemDef {
        name "modern_settings_accent_1"
        rect 444 60 3 16
        style WINDOW_STYLE_FILLED
        backcolor .94 .75 .27 .95
        visible 1
        decoration
    }


    itemDef {
        name "modern_settings_card_2"
        rect 444 360 384 78
        style WINDOW_STYLE_FILLED
        backcolor .045 .065 .085 .98
        visible 1
        decoration
    }
    itemDef {
        name "modern_settings_accent_2"
        rect 444 360 3 16
        style WINDOW_STYLE_FILLED
        backcolor .94 .75 .27 .95
        visible 1
        decoration
    }

// Subwindows //

//#define SUBWINDOW_WIDTH		(SUBWINDOW_WIDTH)
#define SUBWINDOW_WIDTH		WINDOW_WIDTH-12

// Hud Display //

	SUBWINDOW( 24, 60, 384, 352, "HUD Display" )
	YESNO( 32, 78, 368, 30, "Draw FPS:", .22, 14, "cg_drawFPS", "Show frames per second" )
	YESNO( 32, 108, 368, 30, "Show Lagometer:", .22, 14, "cg_lagometer", "Show lagometer" )
	MULTI( 32, 138, 368, 30, "Compass:", .22, 14, "cg_drawCompass", cvarFloatList { "Off" 0 "Classic" 1 "Map" 2 "Blueprint" 3 }, "Map and Blueprint fill the circle with subtle cardinal labels" )
	MULTI( 32, 168, 368, 30, "Mission Timer:", .22, 14, "cg_drawRoundTimer", cvarFloatList { "Off" 0 "On" 1 }, "Show mission time" )
//	MULTI( 8, 96, (SUBWINDOW_WIDTH)-4, 10, "Cursor Hints:", .2, 8, "cg_cursorHints", cvarFloatList { "Off" 0 "Size Pulse" 1 "Strobe Pulse" 2 "Alpha Pulse" 3 "Solid" 4 }, "Icon display format when near an action item" )
	MULTI( 32, 198, 368, 30, "Cursor Hints:", .22, 14, "cg_cursorHints", cvarFloatList { "Off" 0 "On" 1 }, "Icon display when near an action item" )
	MULTI( 32, 228, 368, 30, "Player Icons:", .22, 14, "cg_drawFriend", cvarFloatList { "Off" 0 "Visible" 1 "Always" 2}, "Show floating icon indicating team mates" )
	MULTI( 32, 258, 368, 30, "Country Flags:", .22, 14, "cg_countryflags", cvarFloatList { "Off" 0 "On" 1 }, "Draw country flags beside scoreboard names" )
	MULTI( 32, 288, 368, 30, "Team Names:", .22, 14, "cg_drawTeamNames", cvarFloatList { "Off" 0 "Team" 1 "Fireteam" 2 }, "Show visible teammates' names in green; Fireteam limits names to your fireteam" )
	YESNO( 32, 318, 368, 30, "Crosshair Names:", .22, 14, "cg_drawCrosshairNames", "Show the name of the player under your crosshair" )
	YESNO( 32, 348, 368, 30, "Automatic Widescreen:", .22, 14, "cg_wideScreen", "Use the actual video dimensions with proportional HUD and menu rendering" )
	SLIDER( 32, 378, 368, 30, "HUD Size:", .22, 14, "cg_hudScale" 0.85 0.5 1.5, "Scale HUD widgets; high resolution size is capped by cg_hudMaxHeight" )

// In-Game Display //
	SUBWINDOW( 444, 60, 384, 294, "In-Game Display" )
	MULTI( 452, 78, 368, 34, "Ejecting Brass:", .22, 14, "cg_brassTime", cvarFloatList { "High" 15000 "Med" 2500 "Off" 0 }, "" )
//	YESNO( 8, 326-184+60, (SUBWINDOW_WIDTH)-4, 10, "Low Quality Sky:", .2, 8, "r_fastsky", "" )
	SLIDER( 452, 112, 368, 34, "Dynamic Eye:", .22, 14, "cg_dynamicEye" 0.0 0.0 1.0, "Use the slider to increase or decrease HDR dynamic light adaptation" )

	MULTI( 452, 146, 368, 34, "Corona Distance:", .22, 14, "cg_coronafardist", cvarFloatList { "Off" 0 "Near" 800 "Normal" 1536 "Far" 4096 "Extreme" 16000 }, "" )
	YESNO( 452, 180, 368, 34, "Particles:", .22, 14, "cg_wolfparticles", "" )
	MULTI( 452, 214, 368, 34, "Wall Mark Lifetime:", .22, 14, "cg_markTime", cvarFloatList { "Long" 30000 "Normal" 20000 "Short" 10000 "Off" 0 }, "" )
	MULTI( 452, 248, 368, 34, "Blood Flash:", .22, 14, "cg_bloodFlash", cvarFloatList { "None" 0.0 "Light" 0.25 "Medium" 0.5 "Heavy" 0.75 "Full" 1.0 }, "Red blood \"flash\" scale when receiving damage" )
	MULTI( 452, 282, 368, 34, "Blood Splatter:", .22, 14, "cg_bloodDamageBlend", cvarFloatList { "None" 0.0 "Light" 0.25 "Medium" 0.5 "Heavy" 0.75 "Full" 1.0 }, "Blood \"splatter\" transparency when taking damage from other players" )
	MULTI( 452, 316, 368, 34, "Gun Position:", .22, 14, "cg_gunPosition", cvarFloatList { "More centered" 0 "Default" 1 "More to right" 2  }, "Horizontal position of view weapon" )

// Independent corner widget sizes //
    SUBWINDOW( 444, 360, 384, 78, "Widget Size" )
    SLIDER( 452, 378, 368, 19, "Compass Size:", .22, 14, "cg_compassScale" 0.85 0.5 1.5, "Resize the compass independently of HUD size" )
    SLIDER( 452, 398, 368, 19, "Fireteam Size:", .22, 14, "cg_fireteamScale" 0.85 0.5 1.5, "Resize the fireteam panel independently of HUD size" )
    SLIDER( 452, 418, 368, 19, "Command Map Size:", .22, 14, "cg_commandMapScale" 0.85 0.5 1.5, "Resize the expanded command map independently of HUD size" )

// Buttons //

	BUTTON( 24, 442, 180, 26, "Back", .27, 18, close options_customise_hud ; open options )

itemDef {
            name "modern_nav_game" rect 252 12 112 30
            text "GAME" textfont UI_FONT_ARIBLK_27 textscale .25
            textalign ITEM_ALIGN_CENTER textalignx 56 textaligny 21
            style WINDOW_STYLE_FILLED
            border WINDOW_BORDER_FULL bordercolor .23 .29 .35 .75
            backcolor .08 .12 .16 1
            forecolor .84 .89 .94 1
            visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_nav_game" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_game" forecolor 1 1 1 1 ; setitemcolor "modern_nav_game" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_nav_game" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_game" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_game" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_nav_game" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_game" forecolor 1 1 1 1 ; setitemcolor "modern_nav_game" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_nav_game" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_game" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_game" bordercolor .23 .29 .35 .75 ; }
 action { close options_customise_hud ; open options ; close options ; open options_customise_game }
        }
itemDef {
            name "modern_nav_view" rect 368 12 112 30
            text "VIEW" textfont UI_FONT_ARIBLK_27 textscale .25
            textalign ITEM_ALIGN_CENTER textalignx 56 textaligny 21
            style WINDOW_STYLE_FILLED
            border WINDOW_BORDER_FULL bordercolor .23 .29 .35 .75
            backcolor .94 .75 .27 1
            forecolor .025 .035 .05 1
            visible 1 decoration
        }
itemDef {
            name "modern_nav_controls" rect 484 12 112 30
            text "CONTROLS" textfont UI_FONT_ARIBLK_27 textscale .25
            textalign ITEM_ALIGN_CENTER textalignx 56 textaligny 21
            style WINDOW_STYLE_FILLED
            border WINDOW_BORDER_FULL bordercolor .23 .29 .35 .75
            backcolor .08 .12 .16 1
            forecolor .84 .89 .94 1
            visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_nav_controls" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_controls" forecolor 1 1 1 1 ; setitemcolor "modern_nav_controls" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_nav_controls" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_controls" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_controls" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_nav_controls" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_controls" forecolor 1 1 1 1 ; setitemcolor "modern_nav_controls" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_nav_controls" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_controls" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_controls" bordercolor .23 .29 .35 .75 ; }
 action { close options_customise_hud ; open options ; close options ; open options_controls }
        }
itemDef {
            name "modern_nav_system" rect 600 12 112 30
            text "SYSTEM" textfont UI_FONT_ARIBLK_27 textscale .25
            textalign ITEM_ALIGN_CENTER textalignx 56 textaligny 21
            style WINDOW_STYLE_FILLED
            border WINDOW_BORDER_FULL bordercolor .23 .29 .35 .75
            backcolor .08 .12 .16 1
            forecolor .84 .89 .94 1
            visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_nav_system" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_system" forecolor 1 1 1 1 ; setitemcolor "modern_nav_system" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_nav_system" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_system" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_system" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_nav_system" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_system" forecolor 1 1 1 1 ; setitemcolor "modern_nav_system" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_nav_system" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_system" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_system" bordercolor .23 .29 .35 .75 ; }
 action { close options_customise_hud ; open options ; close options ; open options_system }
        }
itemDef {
            name "modern_nav_appearance" rect 716 12 112 30
            text "APPEARANCE" textfont UI_FONT_ARIBLK_27 textscale .25
            textalign ITEM_ALIGN_CENTER textalignx 56 textaligny 21
            style WINDOW_STYLE_FILLED
            border WINDOW_BORDER_FULL bordercolor .23 .29 .35 .75
            backcolor .08 .12 .16 1
            forecolor .84 .89 .94 1
            visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_nav_appearance" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_appearance" forecolor 1 1 1 1 ; setitemcolor "modern_nav_appearance" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_nav_appearance" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_appearance" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_appearance" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_nav_appearance" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_appearance" forecolor 1 1 1 1 ; setitemcolor "modern_nav_appearance" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_nav_appearance" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_appearance" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_appearance" bordercolor .23 .29 .35 .75 ; }
 action { close options_customise_hud ; open options ; close options ; open modern_appearance }
        }

}
