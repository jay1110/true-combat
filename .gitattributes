* text=auto eol=lf

# Vendor snapshots are content-pinned imports. Do not silently rewrite their
# bytes on another host. Project-owned changes inside these snapshots are
# deliberate updates to vendor/dependencies.lock.json.
/vendor/** -text
/compat/legacy/** -text

# Imported license notices retain their exact supplied bytes on every host.
/LICENSE -text
/EULA_TrueCombat_Elite.txt -text
/src/assets/gfx/flags/LICENSE.xmod.txt -text

# Retained authoring references preserve their original byte encoding.
/tools/ui_modernize/source/** -text -whitespace

# Canonical editable PK3 resources and their original reference must retain exact
# legacy encodings, line endings and binary bytes across Windows/Linux checkouts.
/pak/** -text -whitespace
/pak_original_tce/** -text -whitespace
/navstudio/editor-pak/** -text -whitespace
