#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 104
#define GROUP_NAME		"grpIngameMain"

// Macros //

#include "ui/modern_widgets.h"

// Main Menu //

menuDef {
	name		"ingame_main"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onOpen {
		// ydnar
		conditionalscript ROldModeCheck 2
			( "clearFocus ; open vid_confirm" )
			( "clearFocus" )
	}
	
	onEsc {
		close ingame_main ;
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 104
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}
// Window //

	WINDOW( "Main Menu", 50 )
	
// Buttons //

	BUTTON( 24, 56, 106, 32, "Deployment", .245, 22, clearFocus ; close ingame_main ; exec OpenLimboMenu ; )


	BUTTONEXT( 140, 56, 106, 32, "Vote", .245, 22, uiScript clientCheckVote ; 
															conditionalScript cg_ui_novote 0
																( "clearFocus ; open ingame_votedisabled" )
																( "close ingame_main ; open ingame_vote" ), cvarTest "authLevel" showCVar { RL_NONE } )
	BUTTONEXT( 140, 56, 106, 32, "Referee", .245, 22, close ingame_main ; open ingame_vote, cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 140, 56, 106, 32, "RCON", .245, 22, close ingame_main ; open ingame_vote, cvarTest "authLevel" showCVar { RL_RCON } )
	
	BUTTON( 256, 56, 106, 32, "Server Info", .245, 22, close ingame_main ; open ingame_serverinfo )
	BUTTON( 372, 56, 106, 32, "Options", .245, 22, close ingame_main ; open options )
	BUTTON( 488, 56, 106, 32, "Disconnect", .245, 22, clearFocus ; open ingame_disconnect )
	BUTTON( 604, 56, 106, 32, "Exit TC:E", .245, 22, clearFocus ; open quit )
	BUTTON( 720, 56, 106, 32, "Omni-bot Editor", .245, 22, close ingame_main ; open tce_omnibot )
}
