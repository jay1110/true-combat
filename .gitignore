# Publish the complete mod, bot runtime, authoring tools and build inputs.
# The game installation, original binaries, research and build products stay local.
/*
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/CMakePresets.json
!/BUILDING.md
!/README.md
!/LICENSE
!/EULA_TrueCombat_Elite.txt
!/.github/
!/.github/**
!/cmake/
!/cmake/**
!/compat/
!/compat/**
!/platform/
!/platform/**
!/src/
!/src/**
!/vendor/
!/vendor/**
!/omnibot/
!/omnibot/**
!/navstudio/
!/navstudio/**
!/tce/
!/tce/**
!/tools/
!/tools/**
!/Docs/
/Docs/*
!/Docs/*.md
!/Docs/*.json

# Local instructions, reverse-engineering evidence and external engine checkouts.
/AGENTS.md
/src/AGENTS.md
/src/reconstruction/
/src/vendor/
/src/tools/
/reference/
/build/
/dist/
/state/
/decompiled/
/ET_SDK/

# Generated/compiled files, local environments and editor state.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.venv/
**/venv/
**/node_modules/
**/build/
**/Debug/
**/Release/
**/CMakeFiles/
**/CMakeCache.txt
**/Testing/
**/.vs/
**/*.obj
**/*.o
**/*.a
**/*.dll
**/*.so
**/*.so.*
**/*.dylib
**/*.exe
**/*.wasm
**/*.pdb
**/*.ilk
**/*.exp
**/*.lib
**/*.suo
**/*.user
**/*.log
**/*.dmp
**/*.zip
**/*.pk3
**/.DS_Store

# Local credentials and per-developer configuration never belong in source ZIPs.
**/.env
**/.env.*
CMakeUserPresets.json

# Windows Git treats Release/release directory names alike. These are source
# scripts, not a generated Release directory; retain only explicit inputs.
!/tools/release/
!/tools/release/*.py
!/tools/release/*.json
!/tools/release/*.cfg
!/tools/release/*.md
