cmake_minimum_required(VERSION 3.20)
if(NOT IS_DIRECTORY "${MODULE_DIRECTORY}")
  message(FATAL_ERROR "Set MODULE_DIRECTORY to the directory containing collected module binaries")
endif()
get_filename_component(MODULE_DIRECTORY "${MODULE_DIRECTORY}" ABSOLUTE)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../game/tce_version.h" version_line REGEX "^#define TCE_VERSION ")
string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" version "${version_line}")
if(NOT version)
  message(FATAL_ERROR "Invalid TCE_VERSION")
endif()
set(package_name "tce2-${version}.pk3")
if(NOT BUILD_VARIANT)
  set(BUILD_VARIANT game)
endif()
if(NOT BUILD_VARIANT MATCHES "^(game|navstudio)$")
  message(FATAL_ERROR "BUILD_VARIANT must be game or navstudio")
endif()
if(EXISTS "${MODULE_DIRECTORY}/tce-build-variant.txt")
  file(READ "${MODULE_DIRECTORY}/tce-build-variant.txt" actual_variant)
  string(STRIP "${actual_variant}" actual_variant)
  if(NOT actual_variant STREQUAL BUILD_VARIANT)
    message(FATAL_ERROR "Module variant ${actual_variant} differs from package variant ${BUILD_VARIANT}")
  endif()
endif()
if(BUILD_VARIANT STREQUAL game AND EXISTS "${MODULE_DIRECTORY}/zz_tce2_navstudio_editor.pk3")
  message(FATAL_ERROR "Move the local editor addon outside the public mod directory before packaging")
endif()
file(GLOB installed_packages "${MODULE_DIRECTORY}/*.pk3")
foreach(installed IN LISTS installed_packages)
  get_filename_component(installed_name "${installed}" NAME)
  if(NOT installed_name STREQUAL package_name)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${installed}"
      OUTPUT_VARIABLE entries COMMAND_ERROR_IS_FATAL ANY)
    if(entries MATCHES "(^|\n)(lib)?(cgame|ui)([^/\r\n]*[.](dll|so)|_mac)(\r?\n|$)")
      message(FATAL_ERROR "Conflicting client binary package: ${installed}. Move it outside the mod search path before packaging.")
    endif()
  endif()
endforeach()
# A single resource reader owns both local and full-matrix release packages.
# This includes every file in pak/, plus only the explicit editor overlay.
get_filename_component(tce_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}"
  "${tce_root}/tools/release/resource_assets.py"
  --variant "${BUILD_VARIANT}" --module-directory "${MODULE_DIRECTORY}"
  --output "${MODULE_DIRECTORY}/${package_name}"
  COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Packaged full mod resources and client modules into ${MODULE_DIRECTORY}/${package_name}; qagame remains loose")
