#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpPlayOnlineServerInfo"

// Macros //

#include "ui/modern_widgets.h"
		
// Server Info Menu //
	
menuDef {
	name		"playonline_serverinfo"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	onOpen {
		setcvar ui_serverBrowser 1 ;
		uiScript ServerStatus
	}
	
	onESC {
		close playonline_serverinfo ;
		open playonline
	}
	
// Background //

	itemDef {
		name		"background"
		rect		-5 -85 862 650
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 804
#define SUBWINDOW_HEIGHT 420
#define SUBWINDOW_X 24
#define SUBWINDOW_Y 12

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "SERVER INFO" )
	
	itemDef {
		name			"serverInfo"
		group			GROUP_NAME
		rect			 24 66 804 350
		type			ITEM_TYPE_LISTBOX
		textfont		UI_FONT_COURBD_21
		textstyle		ITEM_TEXTSTYLE_NORMAL
		textscale		.25
		textaligny		-4
		forecolor		.88 .91 .94 1
		feeder			FEEDER_SERVERSTATUS
		elementtype		LISTBOX_TEXT
		elementwidth	780
		elementheight	20
		columns 4 0 250 20 250 120 10 370 120 10 490 280 20
		visible			1
		backcolor	.055 .075 .10 .94
		bordercolor	.23 .29 .35 .75
	}
	
	BUTTON( 24, 442, 256, 28, "BACK", .29, 21, close playonline_serverinfo ; open playonline )
	BUTTON( 294, 442, 256, 28, "REFRESH", .29, 21, uiScript ServerStatus )
	BUTTON( 564, 442, 256, 28, "JOIN SERVER", .29, 21, uiScript JoinServer )
}
