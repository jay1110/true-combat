// This script provides functionality for the bots to pickup close weapons, health, and ammo if they aren't at max levels

// Shared by the TCE FLAGRETURN override after all goal files have loaded.
// These functions select player-origin destinations; they do not alter Goto,
// the ordinary waypoint radius, or the native item pickup rule.
global TCE2ItemContact = {};
TCE2ItemContact.IsTCE = function(bot)
{
    mode = bot.GetStat("tce_gametype");
    return mode == 2 || mode == 5 || mode == 7;
};
TCE2ItemContact.Bounds = function(ent)
{
    box = GetEntWorldAABB(ent);
    if(!box || GetEntFlags(ent, ENTFLAG.DISABLED)) { return null; }
    center = box.CenterPoint();
    width = box.GetAxisLength("x") - 2;
    depth = box.GetAxisLength("y") - 2;
    height = box.GetAxisLength("z") - 2;
    // g_items.c: ITEM_RADIUS=10. SV_LinkEntity pads each side by one.
    // A 20-high item can be dropped [0,20] or suspended [-10,10].
    // Require contact for BOTH possible origins, rather than guessing which.
    if(!(width >= 19.99 && width <= 20.01 && depth >= 19.99 && depth <= 20.01 &&
        ((height >= 9.99 && height <= 10.01) || (height >= 19.99 && height <= 20.01))))
    { return null; }
    low = center.z - height * 0.5;
    high = low;
    if(height > 15) { high = center.z; }
    return {center=center, minZ=high-34, maxZ=low+34};
};
TCE2ItemContact.Contains = function(bounds, pos)
{
    return bounds && pos.x-bounds.center.x >= -34 && pos.x-bounds.center.x <= 34 &&
        pos.y-bounds.center.y >= -34 && pos.y-bounds.center.y <= 34 &&
        pos.z >= bounds.minZ && pos.z <= bounds.maxZ;
};
TCE2ItemContact.Hull = function(bot)
{
    if(bot.HasAnyEntityFlag(ENTFLAG.DEAD, ENTFLAG.LIMBO, ENTFLAG.ON_LADDER) ||
        !bot.HasEntityFlag(ENTFLAG.ON_GROUND)) { return null; }
    box = GetEntWorldAABB(bot.GetGameEntity());
    if(!box) { return null; }
    pos = bot.GetPosition(); center = box.CenterPoint();
    hx = box.GetAxisLength("x") * 0.5 - 1;
    hy = box.GetAxisLength("y") * 0.5 - 1;
    hz = box.GetAxisLength("z") * 0.5 - 1;
    if(!(hx > 0 && hy > 0 && hz > 0)) { return null; }
    // The player AABB API adds two Z units after broadphase padding.
    mins = Vec3(center.x-pos.x-hx, center.y-pos.y-hy, center.z-pos.z-2-hz);
    maxs = Vec3(center.x-pos.x+hx, center.y-pos.y+hy, center.z-pos.z-2+hz);
    return {box=AABB(mins,maxs), mins=mins, maxs=maxs};
};
TCE2ItemContact.Support = function(bot, hull, xy, bottom, top)
{
    if(!hull || !(top > bottom)) { return null; }
    ent = bot.GetGameEntity();
    mask = TRACE.SOLID | TRACE.PLAYERCLIP | TRACE.PLAYER | TRACE.NAVCAPSULE;
    ground = TraceLine(Vec3(xy.x,xy.y,top),Vec3(xy.x,xy.y,bottom),hull.box,mask,ent,false);
    if(ground.startsolid || !(ground.fraction < 1) || !ground.normal || !(ground.normal.z >= 0.7))
    { return null; }
    if((ground.surface & SURFACE.SLICK) && ground.normal.z < 0.9999) { return null; }
    supported = Vec3(ground.end.x,ground.end.y,ground.end.z+0.125);
    // Prove the entire body at the supported pose, without a zero-length trace.
    clear = TraceLine(ground.end,supported,hull.box,mask,ent,false);
    if(clear.startsolid || clear.fraction < 1) { return null; }
    for(sample=0; sample<3; sample+=1)
    {
        z = supported.z+hull.mins.z+1;
        if(sample==1) { z=supported.z+(hull.mins.z+hull.maxs.z)*0.5; }
        if(sample==2) { z=supported.z+hull.maxs.z-1; }
        if(GetPointContents(Vec3(supported.x,supported.y,z)) &
            (CONTENT.WATER | CONTENT.SLIME | CONTENT.LAVA | CONTENT.MOVER)) { return null; }
    }
    return supported;
};
TCE2ItemContact.CheckedPose = function(bot, bounds)
{
    pos=bot.GetPosition(); hull=this.Hull(bot);
    if(!hull || !this.Contains(bounds,pos)) { return false; }
    support=this.Support(bot,hull,pos,pos.z-2.25,pos.z+0.01);
    return support && support.z-pos.z >= -2 && support.z-pos.z <= 0.25;
};
TCE2ItemContact.Find = function(bot, bounds)
{
    hull=this.Hull(bot); if(!hull || !bounds) { return null; }
    pos=bot.GetPosition();
    if(this.CheckedPose(bot,bounds)) { return pos; }
    x=pos.x; y=pos.y;
    if(x < bounds.center.x-30) { x=bounds.center.x-30; }
    if(x > bounds.center.x+30) { x=bounds.center.x+30; }
    if(y < bounds.center.y-30) { y=bounds.center.y-30; }
    if(y > bounds.center.y+30) { y=bounds.center.y+30; }
    candidates={Vec3(x,y,0)}; count=1;
    for(ix=-1;ix<=1;ix+=1) { for(iy=-1;iy<=1;iy+=1)
    { candidates[count]=Vec3(bounds.center.x+ix*28,bounds.center.y+iy*28,0);count+=1; } }
    best=null; bestDistance=100000000;
    foreach(candidate in candidates)
    {
        support=this.Support(bot,hull,candidate,bounds.minZ,bounds.maxZ+0.25);
        if(support && this.Contains(bounds,support))
        {
            distance=DistanceBetween(pos,support);
            if(distance < bestDistance) { best=support;bestDistance=distance; }
        }
    }
    return best;
};
TCE2ItemContact.Log = function(goal, event)
{
    if(GetCvar("omnibot_tce_objective_debug") != 0)
    { print("TCE2ITEM",event,"bot",goal.Bot.GetGameId(),"user",goal.Name,"time",GetTime()); }
};
TCE2ItemContact.Release = function(goal)
{
    if(goal.TCEUseHeld) { goal.Bot.ReleaseButton(BTN.USE);goal.TCEUseHeld=false; }
};
TCE2ItemContact.Approach = function(goal, ent)
{
    bounds=this.Bounds(ent); target=this.Find(goal.Bot,bounds);
    if(!target) { this.Log(goal,"NO_SAFE_CONTACT");return false; }
    if(goal.Goto(target,2) != EVENT.PATH_SUCCESS)
    { this.Log(goal,"ROUTE_FAILED");return false; }
    // Moving/deleted items cannot authorize use at a stale destination.
    fresh=this.Bounds(ent);
    if(!fresh || DistanceBetween(fresh.center,bounds.center)>2 || !this.CheckedPose(goal.Bot,fresh))
    { this.Log(goal,"CONTACT_CHANGED");return false; }
    goal.Stop();goal.AddAimRequest(Priority.High,"position",fresh.center);
    return true;
};

this.Name = "PickupItems";
this.Parent = "HighLevel";
this.AlwaysRecieveEvents = true;
this.AutoAdd = true;
this.PickupPriority = 0.9;
this.Range = 200;
this.Frequency = 5; // 1 to 10, 0 to disable

this.LimitToNoEntityFlag(ENTFLAG.INWATER, ENTFLAG.UNDERWATER);

this.Initialize = function()
{
	watchParams = {
		Radius = this.Range,
		Category = CAT.PICKUP,
		
		// cs: lets pretend bots hear the pack being dropped behind them ...
		// it's reasonable since this is limited to a 200 radius. this should
		// improve the deliver supplies goal success rate.
		//RequireLOS = TRACE.VISIBLE,
	};
	this.WatchForEntityCategory(watchParams);

	Util.ScriptDebugPrint(this.Name, "initialized");
};

this.Enter = function()
{
	if(TCE2ItemContact.IsTCE(this.Bot)) { return; }
	this.AddFinishCriteria(this.TargetEntity, "deleted");
	this.AddFinishCriteria(this.TargetEntity,"hasentflag",ENTFLAG.DISABLED);
};

this.Update = function()
{
	if(TCE2ItemContact.IsTCE(this.Bot)) { this.TCEPickup();return; }
	this.Bot.HoldButton(BTN.SPRINT, 3);
	pos = GetEntPosition(this.TargetEntity);
	if ( pos ) {
		this.Goto(pos, 32);
	}
	this.Finished();
};

this.Exit = function()
{
	TCE2ItemContact.Release(this);
	this.Bot.ReleaseButton(BTN.SPRINT);
	this.TargetEntity = null;
};

this.TCEPickup = function()
{
    ent=this.TargetEntity; category=this.GetPickupCategory(ent);
    weapon=this.Bot.GetCurrentWeapon();
    if(category==CAT.PICKUP_WEAPON) { weapon=GetWeaponIdFromClassId(GetEntClass(ent)); }
    before={}; beforeHealth=this.Bot.Health;
    ammoKnown=weapon && this.Bot.GetCurrentAmmo(before,0,weapon);
    if(!TCE2ItemContact.Approach(this,ent)) { this.Finished();return; }
    deadline=GetTime()+2; confirmed=false;
    while(GetTime()<deadline)
    {
        after={};
        if((category==CAT.PICKUP_HEALTH && this.Bot.Health>beforeHealth) ||
            (ammoKnown && this.Bot.GetCurrentAmmo(after,0,weapon) &&
                after.CurrentAmmo+after.CurrentClip > before.CurrentAmmo+before.CurrentClip))
        { confirmed=true;break; }
        bounds=TCE2ItemContact.Bounds(ent);
        if(!bounds || !TCE2ItemContact.CheckedPose(this.Bot,bounds)) { break; }
        this.Bot.HoldButton(BTN.USE,0.2);this.TCEUseHeld=true;
        sleep(0.1);
    }
    TCE2ItemContact.Release(this);
    if(confirmed) { TCE2ItemContact.Log(this,"INVENTORY_INCREASE"); }
    else { TCE2ItemContact.Log(this,"NOT_CONFIRMED"); }
    this.Finished();
};

this.Events[EVENT.ENT_ENTER_RADIUS] = function(ent)
{
	if ( !this.Bot || this.IsActive() || RandInt(1, 10) >= this.Frequency ) {
		return;
	}

	entCat = this.GetPickupCategory(ent);

	switch(entCat)
	{
		case CAT.PICKUP_WEAPON:
		case CAT.PICKUP_AMMO:
		{
			if ( this.NeedsAmmo(ent, entCat) ) {
				this.TargetEntity = ent;
				this.Priority = this.PickupPriority;
			}
		}
		case CAT.PICKUP_HEALTH:
		{
			if ( this.Bot.Health < this.Bot.MaxHealth ) {
				this.TargetEntity = ent;
				this.Priority = 1.2 - 0.7 * this.Bot.Health / this.Bot.MaxHealth;
			}
		}
	}
};

this.NeedsAmmo = function(ent, entCat)
{
	if ( entCat == CAT.PICKUP_WEAPON ) {
		weapClass = GetEntClass(ent);
		if ( weapClass ) {
			weaponId = GetWeaponIdFromClassId( weapClass );

			// it's a weapon, but not the right type
			if ( !weaponId || !this.Bot.HasWeapon(weaponId) ) {
				return false;
			}
		}
	}
	else {
		weaponId = this.Bot.GetCurrentWeapon();
	}

	// simple check first
	this.Bot.GetMostDesiredAmmo(Util.DesireTable);
	if(Util.DesireTable.Desire > 0) {
		return true;
	}

	// the above check only accounts for current clip
	if (this.Bot.GetCurrentAmmo(Util.AmmoTable, 0, weaponId)) {
		if ( Util.AmmoTable.CurrentAmmo < Util.AmmoTable.MaxAmmo ) {
			return true;
		}
	}

	return false;
};

this.GetPickupCategory = function(ent)
{
	if ( GetEntCategory(ent, CAT.PICKUP_HEALTH) == 1 ) {
		return CAT.PICKUP_HEALTH;
	}

	if ( GetEntCategory(ent, CAT.PICKUP_WEAPON) == 1 ) {
		return CAT.PICKUP_WEAPON;
	}

	if ( GetEntCategory(ent, CAT.PICKUP_AMMO) == 1 ) {
		return CAT.PICKUP_AMMO;
	}

	return -1;
};
