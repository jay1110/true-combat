	itemDef {
		name		"nfleftbackTimelimit:"
		group		GROUP_NAME
		rect		662 360 72 24
		style		WINDOW_STYLE_FILLED
		backcolor	.12 .17 .22 .96
		visible		1
		voteFlag	CV_SVF_TIMELIMIT
		decoration
	}
	NUMERICFIELDLEFTEXT( 588, 360, 146, 24, "Time Limit:", .22, 17, "ui_voteTimelimit", 6, voteFlag CV_SVF_TIMELIMIT, "Set the time limit for the server" )
	NAMEDBUTTONEXT( "bttnextTimelimit", 746, 352, 66, 36, "OK", .28, 24, uiScript refTimelimit; uiScript closeingame, voteFlag CV_SVF_TIMELIMIT )

//	MULTILEFT( 8, 194+2, .66*(WINDOW_WIDTH-18), 10, "Game Type:", .2, 8, "ui_voteGameType", cvarFloatList { "Objective" 5 "Reinforced Objective" 2 "Bodycount" 7 } voteFlag CV_SVF_GAMETYPE, "Set the game type" )
