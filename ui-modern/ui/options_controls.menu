// Subwindows //

#define SUBWINDOW_WIDTH		.5*(WINDOW_WIDTH-18)
	
// Move //

	SUBWINDOW( 24, 60, 256, 213, "Movement" )
	BIND( 32, 78, 240, 15, "Forward:", .22, 13, "+forward", "" )
	BIND( 32, 93, 240, 15, "Back:", .22, 13, "+back", "" )
	BIND( 32, 108, 240, 15, "Move Left:", .22, 13, "+moveleft", "" )
	BIND( 32, 123, 240, 15, "Move Right:", .22, 13, "+moveright", "" )
	BIND( 32, 138, 240, 15, "Lean Left:", .22, 13, "+leanleft", "" )
	BIND( 32, 153, 240, 15, "Lean Right:", .22, 13, "+leanright", "" )
	BIND( 32, 168, 240, 15, "Jump:", .22, 13, "+moveup", "" )
	BIND( 32, 183, 240, 15, "Crouch:", .22, 13, "+movedown", "" )
	BIND( 32, 198, 240, 15, "Prone:", .22, 13, "+prone", "" )
	BIND( 32, 213, 240, 15, "Walk:", .22, 13, "+speed", "" )
	BIND( 32, 228, 240, 15, "Sprint:", .22, 13, "+sprint", "" )
	BIND( 32, 243, 240, 15, "Use (Activate):", .22, 13, "+activate", "" )
	
	CHECKBOXALIGNX( 32, 258, 240, 15, "Crouch is toggle:", .22, 8, 13, "cg_togglecrouch", "Crouch is toggle button if selected" )
	
	
// Input //

	SUBWINDOW( 24, 279, 256, 63, "Mouse Input" )
//	YESNOACTION( 8, 214-2, (SUBWINDOW_WIDTH)-4, 10, "Invert Mouse:", .2, 8, "ui_mousePitch", uiScript update ui_mousePitch )
//	YESNO( 8, 226-2, (SUBWINDOW_WIDTH)-4, 10, "Smooth Mouse:", .2, 8, "m_filter" )
	CHECKBOXALIGNXACTION( 32, 297, 240, 15, "Invert Mouse:", .22, 8, 13, "ui_mousePitch", uiScript update ui_mousePitch, "Inverts mouse pitch" )
	CHECKBOXALIGNX( 32, 312, 240, 15, "Smooth Mouse:", .22, 8, 13, "m_filter", "Smooths out the mouse using interpolation" )
	SLIDER( 32, 327, 240, 15, "Mouse Sensitivity:", .22, 13, "sensitivity" 5 1 30, "Use the slider to increase or decrease mouse sensitivity" )
	CVARFLOATLABEL( 230, 327, 40, 15, "sensitivity", .20, ITEM_ALIGN_RIGHT, 40, 13 )
	
