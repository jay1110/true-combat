#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpPlayOnlineEnablePB"

// Macros //

#include "ui/modern_widgets.h"
		
// Punkbuster Enable Menu //
	
menuDef {
	name		"playonline_enablepb"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	modal
	alwaysontop
	
	onESC {
		close playonline_enablepb ;
		//open playonline_sub
	}
	
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 180
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 150

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "PUNKBUSTER" )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+52, SUBWINDOW_WIDTH-48, 18, "Enable PunkBuster?", .26, ITEM_ALIGN_LEFT, 0, 15 )
	
	BUTTON( SUBWINDOW_X+24, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "YES", .30, 21, uiScript setPbClStatus 1 ; close playonline_enablepb ; /*open playonline_sub*/ )
	BUTTON( SUBWINDOW_X+230, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "NO", .30, 21, close playonline_enablepb ; /*open playonline_sub*/ )
}
