// This script contains functionality to capture flag (or radar parts, documents etc.) and carry them to CAPPOINT goal
this.Name = "FLAG";
this.Parent = "HighLevel";
this.SkipGetPriorityWhenActive = true;

this.GETTING_FLAG = 1;
this.CARRYING_TO_CAP = 2;

this.Initialize = function()
{
	// check for flag status so we can finish if another player grabs it or if dropped flag is returned
	this.LimitTo( this.CheckFlagState, 1, true );
};

this.CheckFlagState = function()
{
	switch(this.GoalState)
	{
		case this.GETTING_FLAG:
		{
			if(this.Bot.IsCarryingFlag()) { return false; }
			if(this.Bot.GetStat("tce_gametype") == 2 && this.MapGoal.GetGoalState() != 1 &&
			   this.MapGoal.GetGoalState() != 2) { return false; }
			return this.Bot.CanGrabItem(this.MapGoal.GetEntity());
		}
		case this.CARRYING_TO_CAP:
		{
			if(!this.Bot.IsCarryingFlag() && this.Bot.GetStat("tce_gametype") == 2)
			{ this.TCECaptureResult(); }
			return this.Bot.IsCarryingFlag();
		}
	}
	return true;
};

this.GetPriority = function()
{
	while(1)
	{
		this.Priority = 0;
		if (this.Bot.IsCarryingFlag())
		{
			query = 0xc9326a43 /* CAPPOINT */;
			state = this.CARRYING_TO_CAP;
		}
		else
		{
			query = 0xbdeaa8d7 /* FLAG */;
			state = this.GETTING_FLAG;
		}

		if ( this.QueryGoals(Util.QueryTable, query) )
		{
			foreach ( goal in Util.QueryTable )
			{
				if (state == this.GETTING_FLAG) {
					ent = goal.GetEntity();
					if(this.Bot.GetStat("tce_gametype") == 2 && goal.GetGoalState() != 1 && goal.GetGoalState() != 2) { continue; }
					if (!ent || !this.Bot.CanGrabItem(ent)) {
						continue;
					}
				} else { //state == this.CARRYING_TO_CAP
					if (this.Bot.CappointGoal) //it is set by Util.CappointForFlag
					{
						foreach ( goal2 in Util.QueryTable )
						{
							if ( goal2 == this.Bot.CappointGoal )
							{
								goal = goal2;
								break;
							}
						}
					}
				}
				this.GoalState = state;
				this.MapGoal = goal;
				this.Priority = goal.GetGoalPriority(this.Bot);
				break;
			}
		}

		sleep(2);
	}
};

this.Enter = function()
{
	if(!this.MarkInProgress()) { this.Finished(); }
};

this.Exit = function()
{
	 this.TCEReleaseUse();
	 this.GoalState = null;
};
this.TCEReleaseUse = function()
{
    if(this.TCEUseHeld) { this.Bot.ReleaseButton(BTN.USE); this.TCEUseHeld=false; }
};
this.TCEHoldUse = function()
{
    if(!this.TCEUseHeld) { this.TCETrace("USE"); }
    this.Bot.HoldButton(BTN.USE,0.3);
    this.TCEUseHeld=true;
};
this.TCECaptureCountAdvanced = function()
{
    if(typeName(this.TCECaptureBefore) != "int") { return false; }
    count=this.Bot.GetStat("tce_flag_capture_count");
    return typeName(count) == "int" && (count > this.TCECaptureBefore ||
           (this.TCECaptureBefore == 2147483647 && count == 1));
};
this.TCECaptureResult = function()
{
    if(this.TCECaptureReported || typeName(this.TCECaptureBefore) != "int") { return; }
    if(this.TCECaptureCountAdvanced())
    { this.TCETrace("CAPTURED"); }
    else { this.TCETrace("CARRY_LOST_WITHOUT_CAPTURE"); }
    this.TCECaptureReported=true;
};

// Only NavStudio's natively checked TC flag anchors opt in. The live flag
// remains dynamic for dropped/carried states and ordinary ET maps.
this.TCEFlagAtCheckedBase = function()
{
    if(this.MapGoal.GetGoalState() != 1) { return false; } // S_FLAG_AT_BASE
    pos = this.MapGoal.GetPosition();
    base = this.MapGoal.FlagBasePosition;
    usePos = this.MapGoal.UsePosition;
    // Keep BG_PlayerTouchesItem's +/-36 origin box, including the two-unit
    // final tolerance, even when the live entity drifts slightly from snapshot.
    if(usePos.x-pos.x > 33.875 || usePos.x-pos.x < -33.875 ||
       usePos.y-pos.y > 33.875 || usePos.y-pos.y < -33.875 ||
       usePos.z-pos.z > 33.875 || usePos.z-pos.z < -33.875) { return false; }
    return pos.x-base.x <= 2 && pos.x-base.x >= -2 &&
           pos.y-base.y <= 2 && pos.y-base.y >= -2 &&
           pos.z-base.z <= 2 && pos.z-base.z >= -2;
};
this.TCETrace = function(event)
{
    if(GetCvar("omnibot_tce_objective_debug") != 0)
    { print("TCEFLAG",event,"bot",this.Bot.GetGameId(),"goal",this.MapGoal.GetName(),"time",GetTime()); }
};
this.TCECheckedApproach = function()
{
    usePos = this.MapGoal.UsePosition;
    if(!this.TCEFlagAtCheckedBase())
    { this.TCETrace("BASE_MOVED"); this.BlackboardDelay(10); this.Finished(); return; }
    this.MapGoal.ClearUsePoints();
    this.MapGoal.AddUsePoint(usePos, false); // absolute actor origin, not entity-local
    this.AddAimRequest(Priority.Low,"movedirection");
    if(this.RouteTo(this.MapGoal,32) != EVENT.PATH_SUCCESS)
    { this.TCETrace("NO_ROUTE_PATH"); Util.PathFailed(this); this.Finished(); return; }
    if(!this.TCEFlagAtCheckedBase()) { this.Finished(); return; }
    if(this.Goto(usePos,this.MapGoal.ActivationRadius) != EVENT.PATH_SUCCESS)
    { this.TCETrace("NO_USE_PATH"); Util.PathFailed(this); this.Finished(); return; }
    if(!this.MarkInUse()) { this.Finished(); return; }
    this.Stop();
    this.AddAimRequest(Priority.High,"position",this.MapGoal.GetPosition());
    this.TCETrace("AT_CHECKED_FLOOR");
    // TC's Touch_Item requires held +activate as well as native contact.
    // Real powerups, not path arrival or a changed goal state, prove pickup.
    deadline = GetTime()+3;
    while(GetTime() < deadline && this.CheckFlagState() && this.TCEFlagAtCheckedBase())
    { this.TCEHoldUse(); sleep(0.1); }
    this.TCEReleaseUse();
    if(this.Bot.IsCarryingFlag()) { this.TCETrace("PICKED_UP"); }
    else if(this.CheckFlagState())
    { this.TCETrace("NO_PICKUP"); this.BlackboardDelay(10); }
    this.Finished();
};
this.TCECarryToCap = function()
{
    if(!this.Bot.IsCarryingFlag()) { this.Finished(); return; }
    this.TCECaptureBefore=this.Bot.GetStat("tce_flag_capture_count");
    this.TCECaptureReported=false;
    this.TCETrace("CARRY_TO_CAP");
    this.AddAimRequest(Priority.Low,"movedirection");
    if(this.RouteTo(this.MapGoal,32) != EVENT.PATH_SUCCESS)
    { this.TCETrace("NO_CAP_ROUTE"); Util.PathFailed(this); this.Finished(); return; }
    radius=this.MapGoal.GetRadius();
    if(radius<=0 || radius>2) { radius=2; }
    if(this.Goto(this.MapGoal.GetPosition(),radius) != EVENT.PATH_SUCCESS)
    { this.TCETrace("NO_CAP_PATH"); Util.PathFailed(this); this.Finished(); return; }
    if(!this.MarkInUse()) { this.Finished(); return; }
    this.Stop();this.TCETrace("AT_CAPPOINT");
    deadline=GetTime()+2;
    // trigger_flagonly without KILL_FLAG intentionally retains the powerup.
    // Its real native capture event proves success independently of loss.
    while(GetTime()<deadline && this.Bot.IsCarryingFlag() && !this.TCECaptureCountAdvanced()) { sleep(0.1); }
    if(this.Bot.IsCarryingFlag() && !this.TCECaptureCountAdvanced())
    { this.TCETrace("NO_CAPTURE"); this.BlackboardDelay(10); }
    else { this.TCECaptureResult(); }
    this.Finished();
};
this.TCEGetDroppedFlag = function()
{
    this.TCEReleaseUse();
    if(this.Bot.IsCarryingFlag() || this.MapGoal.GetGoalState()!=2)
    { this.Finished();return; }
    ent=this.MapGoal.GetEntity();
    if(!TCE2ItemContact || !ent || !this.Bot.CanGrabItem(ent) ||
       !TCE2ItemContact.Approach(this,ent))
    { this.TCETrace("NO_DROPPED_CONTACT");this.BlackboardDelay(10);this.Finished();return; }
    if(this.MapGoal.GetGoalState()!=2 || !this.Bot.CanGrabItem(ent))
    { this.TCEReleaseUse();this.Finished();return; }
    if(!this.MarkInUse()) { this.TCEReleaseUse();this.Finished();return; }
    deadline=GetTime()+3;
    while(GetTime()<deadline && !this.Bot.IsCarryingFlag() && this.MapGoal.GetGoalState()==2)
    {
        bounds=TCE2ItemContact.Bounds(ent);
        if(!bounds || !this.Bot.CanGrabItem(ent) || !TCE2ItemContact.CheckedPose(this.Bot,bounds)) { break; }
        this.TCEHoldUse();sleep(0.1);
    }
    this.TCEReleaseUse();
    // A disappeared item or another carrier never proves this bot picked up.
    if(this.Bot.IsCarryingFlag()) { this.TCETrace("PICKED_UP"); }
    else if(this.MapGoal.GetGoalState()==2 && this.Bot.CanGrabItem(ent))
    { this.TCETrace("NO_PICKUP");this.BlackboardDelay(10); }
    else { this.TCETrace("DROPPED_STATE_CHANGED"); }
    this.Finished();
};
this.Update = function()
{
    if(this.GoalState == this.CARRYING_TO_CAP && this.Bot.GetStat("tce_gametype") == 2)
    { this.TCECarryToCap(); return; }
    if(this.GoalState == this.GETTING_FLAG && this.Bot.GetStat("tce_gametype") == 2 &&
       this.MapGoal.GetGoalState()==2)
    {
        this.MapGoal.ClearUsePoints();
        this.TCEGetDroppedFlag();return;
    }
    if(this.GoalState == this.GETTING_FLAG && this.MapGoal.TCECheckedUse == 1 &&
       this.Bot.GetStat("tce_gametype") == 2)
    {
        if(this.MapGoal.GetGoalState() == 1)
        { this.TCECheckedApproach(); return; }
        // A base anchor cannot follow a dropped flag. Restore dynamic routing.
        this.MapGoal.ClearUsePoints();
    }
	Util.RouteTo(this);

	pos = this.MapGoal.GetPosition();
	this.AddAimRequest(Priority.High, "position", pos);

	for(timeout = 100; this.CheckFlagState(); timeout -= 1)
	{
		if(this.GoalState == this.GETTING_FLAG && this.Bot.GetStat("tce_gametype") == 2)
		{ this.TCEHoldUse(); }
		this.Bot.MoveTowards(pos);
		yield();
		if ( timeout < 0 ) {
			this.BlackboardDelay(10);
			Util.ScriptDebugPrint(this.MapGoal.GetName(), "timedout");
			break;
		}
	}
    this.TCEReleaseUse();
	if(this.Bot.GetStat("tce_gametype") == 2 && this.Bot.IsCarryingFlag()) { this.TCETrace("PICKED_UP"); }
	this.Finished();
};
