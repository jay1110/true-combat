include_guard(GLOBAL)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" tce_cpu)
if(EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
  set(TCE_TARGET_OS wasm)
  set(TCE_TARGET_ARCH wasm32)
  set(TCE_MODULE_ARCH wasm32)
elseif(ANDROID)
  set(TCE_TARGET_OS android)
  if(CMAKE_ANDROID_ARCH_ABI STREQUAL "armeabi-v7a" OR ANDROID_ABI STREQUAL "armeabi-v7a")
    set(TCE_TARGET_ARCH armv7)
    set(TCE_MODULE_ARCH armeabi-v7a)
  elseif(CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a" OR ANDROID_ABI STREQUAL "arm64-v8a")
    set(TCE_TARGET_ARCH aarch64)
    set(TCE_MODULE_ARCH arm64-v8a)
  else()
    message(FATAL_ERROR "Supported Android mod ABIs: armeabi-v7a and arm64-v8a")
  endif()
elseif(APPLE)
  set(TCE_TARGET_OS macos)
  if(NOT CMAKE_OSX_ARCHITECTURES)
    set(CMAKE_OSX_ARCHITECTURES "x86_64;arm64" CACHE STRING "macOS module slices" FORCE)
  endif()
  list(LENGTH CMAKE_OSX_ARCHITECTURES tce_macos_slice_count)
  foreach(tce_macos_slice IN LISTS CMAKE_OSX_ARCHITECTURES)
    if(NOT tce_macos_slice MATCHES "^(x86_64|arm64)$")
      message(FATAL_ERROR "Supported macOS mod slices: x86_64 and arm64")
    endif()
  endforeach()
  if(tce_macos_slice_count GREATER 1)
    set(TCE_TARGET_ARCH universal)
  elseif(CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
    set(TCE_TARGET_ARCH aarch64)
  else()
    set(TCE_TARGET_ARCH x86_64)
  endif()
  set(TCE_MODULE_ARCH mac)
elseif(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
  if(WIN32)
    set(TCE_TARGET_OS windows)
  else()
    set(TCE_TARGET_OS linux)
  endif()
  if(tce_cpu MATCHES "^(x86|i[3-6]86|x86_64|amd64|x64)$")
    if(CMAKE_SIZEOF_VOID_P EQUAL 4)
      set(TCE_TARGET_ARCH i386)
      set(TCE_MODULE_ARCH i386)
      if(WIN32)
        set(TCE_MODULE_ARCH x86)
      endif()
    else()
      set(TCE_TARGET_ARCH x86_64)
      set(TCE_MODULE_ARCH x86_64)
      if(WIN32)
        set(TCE_MODULE_ARCH x64)
      endif()
    endif()
  elseif(NOT WIN32 AND tce_cpu MATCHES "^(aarch64|arm64|armv8.*)$" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(TCE_TARGET_ARCH aarch64)
    set(TCE_MODULE_ARCH aarch64)
  elseif(NOT WIN32 AND tce_cpu MATCHES "^(arm|armv[5-8].*)$" AND CMAKE_SIZEOF_VOID_P EQUAL 4)
    set(TCE_TARGET_ARCH armv7)
    set(TCE_MODULE_ARCH armv7)
  else()
    message(FATAL_ERROR "Unsupported mod target CPU/ABI: ${CMAKE_SYSTEM_PROCESSOR}, ${CMAKE_SIZEOF_VOID_P}-byte pointers")
  endif()
else()
  message(FATAL_ERROR "Supported mod OS families: Windows, Linux, Android, macOS, Emscripten")
endif()

add_library(tce_build_options INTERFACE)
target_include_directories(tce_build_options INTERFACE "${TCE_ROOT_DIR}")
# Preserve historical non-aliasing assumptions while the classified compatibility
# layer is validated. Do not turn on fast-math or alter floating-point profiles.
if(MSVC)
  target_compile_options(tce_build_options INTERFACE /W3 /Zc:preprocessor-)
  target_compile_definitions(tce_build_options INTERFACE _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_DEPRECATE)
elseif(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
  target_compile_options(tce_build_options INTERFACE -fno-strict-aliasing)
endif()
if(TCE_ENABLE_SANITIZERS)
  if(MSVC)
    if(NOT TCE_SANITIZERS STREQUAL "address")
      message(FATAL_ERROR "MSVC/clang-cl supports this bundle with -DTCE_SANITIZERS=address; use Clang/GCC Unix for address,undefined")
    endif()
    foreach(tce_lang C CXX)
      string(REGEX REPLACE "/RTC[^ ]*" "" CMAKE_${tce_lang}_FLAGS_DEBUG "${CMAKE_${tce_lang}_FLAGS_DEBUG}")
    endforeach()
    target_compile_options(tce_build_options INTERFACE /fsanitize=address /Zi)
    target_link_options(tce_build_options INTERFACE /INCREMENTAL:NO)
  elseif(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
    target_compile_options(tce_build_options INTERFACE "-fsanitize=${TCE_SANITIZERS}" -fno-omit-frame-pointer)
    target_link_options(tce_build_options INTERFACE "-fsanitize=${TCE_SANITIZERS}")
  else()
    message(FATAL_ERROR "Sanitizers require Clang, GCC or a compatible MSVC AddressSanitizer toolchain")
  endif()
endif()

function(tce_configure_mod target folder define)
  target_link_libraries(${target} PRIVATE tce_build_options)
  target_compile_definitions(${target} PRIVATE ${define})
  if(FEATURE_NAVSTUDIO)
    target_compile_definitions(${target} PRIVATE FEATURE_NAVSTUDIO)
  endif()
  set_target_properties(${target} PROPERTIES PREFIX "" POSITION_INDEPENDENT_CODE ON
    LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
  if(WIN32)
    target_sources(${target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/${folder}/${folder}.def")
    target_compile_definitions(${target} PRIVATE WIN32 _WINDOWS)
    target_link_libraries(${target} PRIVATE winmm)
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "${target}_mp_${TCE_MODULE_ARCH}")
  elseif(EMSCRIPTEN)
    target_compile_options(${target} PRIVATE -fno-common -fvisibility=hidden)
    target_link_options(${target} PRIVATE -sSIDE_MODULE=1)
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "${target}.mp.wasm32" SUFFIX ".so")
  elseif(APPLE)
    # Do not activate the old MACOS_X/PPC math block in the SDK header.
    target_compile_definitions(${target} PRIVATE CPUSTRING="macos-universal" PATH_SEP=47 MAC_STATIC=)
    target_link_options(${target} PRIVATE "LINKER:-exported_symbol,_dllEntry" "LINKER:-exported_symbol,_vmMain")
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "${target}_mac" SUFFIX ""
      OSX_ARCHITECTURES "${CMAKE_OSX_ARCHITECTURES}")
  else()
    target_compile_options(${target} PRIVATE -fcommon)
    target_link_libraries(${target} PRIVATE m)
    target_link_options(${target} PRIVATE -Wl,--no-undefined -Wl,-Bsymbolic)
    if(ANDROID)
      set_target_properties(${target} PROPERTIES PREFIX "lib" OUTPUT_NAME "${target}.mp.android.${TCE_MODULE_ARCH}")
    else()
      set_target_properties(${target} PROPERTIES OUTPUT_NAME "${target}.mp.${TCE_MODULE_ARCH}")
    endif()
  endif()
endfunction()

message(STATUS "TC:E mod-only target: ${TCE_TARGET_OS}/${TCE_TARGET_ARCH}; compiler=${CMAKE_C_COMPILER_ID}; authoring=${FEATURE_NAVSTUDIO}")
