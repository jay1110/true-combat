// Native TC loadout requests; the server still enforces map/team/class restrictions.
Commands["tceweapon"] = {
 Func = function(params) {
  if (tableCount(params) < 2) { print("Usage: /bot tceweapon <botname> <slot e.g. TH7> [secondary]"); return; }
  weapon = WEAPON[params[1]];
  if (!weapon) { print("Unknown TC weapon slot: ", params[1]); return; }
  foreach (bot in BotTable) {
   if (bot.Name == params[0]) {
    if (params[2] == "secondary") { accepted = bot.ChangeSecondaryWeapon(weapon); }
    else { accepted = bot.ChangePrimaryWeapon(weapon); }
    if (accepted) { print("TC weapon accepted for next spawn: ", params[1]); }
    else { print("TC weapon rejected by current team/class/map restrictions: ", params[1]); }
    return;
   }
  }
  print("Bot name not found: ", params[0]);
 },
 Help = {"Select TC gear for next spawn: tceweapon <botname> <TH/SH slot> [secondary]"},
};
Commands["tceclass"] = {
 Func = function(params) {
  if (tableCount(params) < 2) { print("Usage: /bot tceclass <botname> <ASSAULT|RECON|SNIPER|AUTO>"); return; }
  classes = { ASSAULT = CLASS.ASSAULT, RECON = CLASS.RECON, SNIPER = CLASS.SNIPER };
  if (params[1] != "AUTO" && !classes[params[1]]) { print("Unknown TC class"); return; }
  foreach (bot in BotTable) {
   if (bot.Name == params[0]) {
    if (params[1] == "AUTO") { bot.crucialClass = false; }
    else { bot.crucialClass = true; bot.ChangeClass(classes[params[1]]); }
    print("TC class preference updated; changes take effect on next spawn.");
    return;
   }
  }
  print("Bot name not found: ", params[0]);
 },
 Help = {"Select TC class for next spawn; AUTO restores class balancing"},
};

// Read-only inspection for Studio validation. No objective state is changed.
Commands["tceobjectives"] = {
 Func = function(params) {
  goals = {};
  GetGoals(goals,0,"TCEOBJECTIVE_.*|FLAG_.*|CAPPOINT_.*");
  foreach(goal in goals) {
   ent = goal.GetEntity();
   if(ent && EntityIsValid(ent)) {
    print("TCEOBJECTIVE_STATUS",goal.GetName(),"entity",GetGameIdFromEntity(ent),
     "owner",GetEntityStat(ent,"tce_objective_owner"),"state",GetEntityStat(ent,"tce_objective_state"),
     "bomb",GetEntityStat(ent,"tce_objective_bomb"),"flag_stock",GetEntityStat(ent,"tce_flag_captures"));
    if(goal.GetGoalType() == "Flag" || goal.GetGoalType() == "flag") // native FlagState, not a touch assumption
    { print("TCEFLAG_STATUS",goal.GetName(),"entity",GetGameIdFromEntity(ent),"state",goal.GetGoalState()); }
   }
  }
  foreach(bot in BotTable) {
   print("TCEFLAG_BOT",bot.GetGameId(),"team",bot.GetTeam(),"carrying",bot.IsCarryingFlag(),
    "flag",bot.GetStat("tce_carried_flag"),"tag",bot.GetStat("tce_carried_flag_tag"),
    "capture_count",bot.GetStat("tce_flag_capture_count"),"capture_time",bot.GetStat("tce_last_flag_capture_time"),
    "capture_trigger",bot.GetStat("tce_last_flag_capture_trigger"),"capture_parent",bot.GetStat("tce_last_flag_capture_parent"));
   print("TCEOBJECTIVE_BOT",bot.GetGameId(),"team",bot.GetTeam(),"carrier",bot.GetStat("tce_bomb_carrier"),
    "planted",bot.GetStat("tce_bomb_planted"),"hint",bot.GetStat("tce_cursor_hint"),
    "plants",bot.GetStat("tce_bomb_plant_count"),"defuses",bot.GetStat("tce_bomb_defuse_count"),
    "plant_time",bot.GetStat("tce_last_plant_time"),"defuse_time",bot.GetStat("tce_last_defuse_time"),
    "plant_bomb",bot.GetStat("tce_last_plant_bomb"),"defuse_bomb",bot.GetStat("tce_last_defuse_bomb"),
    "plant_objective",bot.GetStat("tce_last_plant_objective"));
  }
 },
 Help = {"Read current TC objective entities, flag captures and bot action state"},
};
