#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpIngameVote"

// Macros //

#include "ui/modern_widgets.h"

// Vote Menu //

menuDef {
	name		"ingame_vote"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
  
	onOpen {
		uiScript voteInitToggles
	}
	
	onEsc {
		close ingame_vote ;
		open ingame_main
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}
// Window //

	WINDOW( "", 50)

	itemDef {
		name		"windowtitle"
		group		GROUP_NAME
		rect		24 8 804 36
		text		"Vote"
		textfont	UI_FONT_ARIBLK_27
		textscale	.44
		textalignx	0
		textaligny	28
		forecolor	.94 .75 .27 1
		border		WINDOW_BORDER_FULL
		bordercolor	0 0 0 0
		cvarTest	"authLevel"
		showCVar	{ RL_NONE }
		visible		1
		decoration
		textstyle	ITEM_TEXTSTYLE_NORMAL
		textalign	ITEM_ALIGN_LEFT
	}
	
	itemDef {
		name		"windowtitle"
		group		GROUP_NAME
		rect		24 8 804 36
		text		"Referee"
		textfont	UI_FONT_ARIBLK_27
		textscale	.44
		textalignx	0
		textaligny	28
		forecolor	.94 .75 .27 1
		border		WINDOW_BORDER_FULL
		bordercolor	0 0 0 0
		cvarTest	"authLevel"
		showCVar	{ RL_REFEREE }
		visible		1
		decoration
		textstyle	ITEM_TEXTSTYLE_NORMAL
		textalign	ITEM_ALIGN_LEFT
	}
	
	itemDef {
		name		"windowtitle"
		group		GROUP_NAME
		rect		24 8 804 36
		text		"RCON"
		textfont	UI_FONT_ARIBLK_27
		textscale	.44
		textalignx	0
		textaligny	28
		forecolor	.94 .75 .27 1
		border		WINDOW_BORDER_FULL
		bordercolor	0 0 0 0
		cvarTest	"authLevel"
		showCVar	{ RL_RCON }
		visible		1
		decoration
		textstyle	ITEM_TEXTSTYLE_NORMAL
		textalign	ITEM_ALIGN_LEFT
	}
	
// Buttons //
	
	BUTTONEXT( 24, 116, 256, 184, "MISC", .42, 125, close ingame_vote ; open ingame_vote_misc, cvarTest "authLevel" showCVar { RL_NONE } )
	BUTTONEXT( 24, 116, 256, 184, "MISC", .42, 125, close ingame_vote ; open ingame_vote_misc_refrcon, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 298, 116, 256, 184, "MAP", .42, 125, close ingame_vote ; open ingame_vote_map, cvarTest "authLevel" showCVar { RL_NONE } voteflag CV_SVF_MAP )
	BUTTONEXT( 298, 116, 256, 184, "MAP", .42, 125, close ingame_vote ; open ingame_vote_map, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTONEXT( 572, 116, 256, 184, "PLAYERS", .42, 125, close ingame_vote ; open ingame_vote_players, cvarTest "authLevel" showCVar { RL_NONE } voteFlag $evalint(CV_SVF_KICK + CV_SVF_REFEREE + CV_SVF_MUTING) )
	BUTTONEXT( 572, 116, 256, 184, "PLAYERS", .42, 125, close ingame_vote ; open ingame_vote_players, cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON } )
	BUTTON( 24, 442, 184, 28, "BACK", .28, 19, close ingame_vote ; open ingame_main )
}
