set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(TCE_ZIG_EXECUTABLE)
  set(CMAKE_C_COMPILER "${TCE_ZIG_EXECUTABLE}")
  set(CMAKE_CXX_COMPILER "${TCE_ZIG_EXECUTABLE}")
  set(CMAKE_C_COMPILER_ARG1 "cc -target aarch64-linux-gnu.2.17")
  set(CMAKE_CXX_COMPILER_ARG1 "c++ -target aarch64-linux-gnu.2.17")
  set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TCE_ZIG_EXECUTABLE)
  # CMake's verbose linker probe (-Wl,-v) is not a supported Zig linker arg.
  # Suppress only probe verbosity so CMake can extract ABI sizes from its ELF.
  set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/../../src/cmake/linux-zig-rules.cmake")
else()
  set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
  set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
endif()
if(TCE_SYSROOT)
  set(CMAKE_SYSROOT "${TCE_SYSROOT}")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
