	itemDef {
		name		"nfleftbackTimelimit:"
		group		GROUP_NAME
		rect		662 272 72 24
		style		WINDOW_STYLE_FILLED
		backcolor	.12 .17 .22 .96
		visible		1
		voteFlag	CV_SVF_TIMELIMIT
		decoration
	}
	NUMERICFIELDLEFTEXT( 588, 272, 146, 24, "Time Limit:", .22, 17, "ui_voteTimelimit", 6, voteFlag CV_SVF_TIMELIMIT, "Specify a time limit to vote on" )
	NAMEDBUTTONEXT( "bttnextTimelimit", 746, 264, 66, 36, "OK", .28, 24, uiScript voteTimelimit; uiScript closeingame, voteFlag CV_SVF_TIMELIMIT )

//	MULTILEFT( 8, 194+2, .66*(WINDOW_WIDTH-18), 10, "Game Type:", .2, 8, "ui_voteGameType", cvarFloatList { "Single-Map Objective" 2 "Stopwatch" 3 "Last Man Standing" 5 } voteflag CV_SVF_GAMETYPE, "Select the game type to vote on" )
