// This script contains functionality to allow bots to camp on a given position. It can be restricted to specific weapons (panzer, flamethrower, sniper).
this.Name = "CAMP";
this.Parent = "HighLevel";
this.SkipGetPriorityWhenActive = true;
this.Debug = false;
this.TCEStationCycle = 0;
this.query = { 0xa9ef3654 /* CAMP */, 0x4fed19c1 /* DEFEND */, 0x4595b8fd /* ATTACK */, 0xe8fbadc0 /* SNIPE */ };

// Only exact goals listed by a generated TCE2 map script opt in. Original ET
// maps and authored CAMP/DEFEND/SNIPE goals retain the stock behavior below.
this.TCEGeneratedType = function(goal, bot)
{
    if (!goal || !Map || !Map.NavStudioTactics) { return null; }
    policy = Map.NavStudioTactics;
    if (policy.MapName != GetMapName() || policy.Gametype != bot.GetStat("tce_gametype")) { return null; }
    return policy.Goals[goal.GetName()];
};
this.TCETacticalAvailable = function(bot)
{
    if (bot.HasAnyEntityFlag(ENTFLAG.DEAD, ENTFLAG.LIMBO, ENTFLAG.CARRYINGGOAL) ||
        bot.IsCarryingFlag() || bot.GetStat("tce_bomb_carrier") == 1) { return false; }
    // All ordinary camping yields to a live bomb: eligible teammates must be
    // free to defuse; neither a flag carrier nor a bomb carrier becomes a guard.
    if (bot.GetStat("tce_gametype") == 5 && bot.GetStat("tce_bomb_planted") == 1) { return false; }
    return true;
};
this.TCERoleInfo = function(bot)
{
    if (!BotTable || !this.TCETacticalAvailable(bot)) { return null; }
    team = bot.GetTeam(); own = bot.GetGameId(); count = 0; lower = 0;
    foreach (teammate in BotTable)
    {
        if (teammate.GetTeam() == team && this.TCETacticalAvailable(teammate))
        {
            count += 1;
            if (teammate.GetGameId() < own) { lower += 1; }
        }
    }
    // At most one third, capped at two guards; a small/surviving team keeps
    // everyone on the objective. Stable native IDs avoid per-frame role churn.
    guards = ToInt(count / 3);
    if (guards > 2) { guards = 2; }
    // Another bounded third can take flank/approach positions. At least the
    // remaining third still executes native missions; carriers never enter.
    flankers = ToInt(count / 3);
    if (flankers > 2) { flankers = 2; }
    return {rank=lower,guards=guards,flankers=flankers};
};
this.TCEDefender = function(bot)
{
    role = this.TCERoleInfo(bot);
    return role && role.rank < role.guards;
};
this.TCESectors = function(kind,bot)
{
    policy = Map.NavStudioTactics;
    if (!policy || !policy.Sectors || !policy.Sectors[bot.GetTeam()]) { return null; }
    sectors = policy.Sectors[bot.GetTeam()][kind];
    if (!sectors || tableCount(sectors) == 0) { return null; }
    return sectors;
};
this.TCEStationAllowed = function(goal,kind,bot)
{
    sectors = this.TCESectors(kind,bot);
    if (!sectors) { return true; } // older generated companions keep their policy
    role = this.TCERoleInfo(bot);
    if (!role) { return false; }
    slot = role.rank; quota = role.guards;
    if (kind == "Attack") { slot -= role.guards; quota = role.flankers; }
    if (slot < 0 || slot >= quota) { return false; }
    if (!this.TCEStationPicks) { this.TCEStationPicks = {}; }
    pick = this.TCEStationPicks[kind]; now = GetTime();
    if (!pick || pick.time != now)
    {
        total = tableCount(sectors);
        preferred = (this.TCEStationCycle * quota + slot) % total;
        chosen = null;
        for (offset=0; offset<total && !chosen; offset+=1)
        {
            candidate = sectors[(preferred+offset)%total];
            // QueryGoals already applies native availability, max-users and
            // blackboard cooldowns. Do not reserve an unavailable position.
            foreach (available in Util.QueryTable)
            {
                if (available.GetName() != candidate) { continue; }
                occupied = false;
                foreach (teammate in BotTable)
                {
                    if (teammate.GetTeam() == bot.GetTeam() && teammate.GetGameId() != bot.GetGameId() &&
                        this.TCETacticalAvailable(teammate) &&
                        teammate.GetMapGoalName && teammate.GetMapGoalName() == candidate)
                    { occupied = true; break; }
                }
                if (!occupied) { chosen = candidate; break; }
            }
        }
        pick = {time=now,name=chosen}; this.TCEStationPicks[kind] = pick;
    }
    return pick.name == goal.GetName();
};
this.TCEEligible = function(goal, bot, current)
{
    kind = current.TCEGeneratedType(goal, bot);
    if (!kind) { return true; }
    if (!current.TCETacticalAvailable(bot)) { return false; }
    if (kind == "Defend" && !current.TCEDefender(bot)) { return false; }
    if (kind == "Defend" || kind == "Attack") { return current.TCEStationAllowed(goal,kind,bot); }
    return true;
};
this.TCEActiveAllowed = function()
{
    if (!this.MapGoal) { return true; }
    kind = this.TCEGeneratedType(this.MapGoal,this.Bot);
    if (!kind) { return true; }
    if (!this.TCETacticalAvailable(this.Bot)) { return false; }
    if (kind == "Defend") { return this.TCEDefender(this.Bot); }
    if (kind == "Attack" && this.TCESectors(kind,this.Bot))
    {
        role=this.TCERoleInfo(this.Bot);
        return role && role.rank >= role.guards && role.rank < role.guards+role.flankers;
    }
    return true;
};
this.TCETrace = function(event)
{
    if (GetCvar("omnibot_tce_objective_debug") != 0 && this.TCEGeneratedType(this.MapGoal, this.Bot))
    { print("TCE2TACTIC",event,"bot",this.Bot.GetGameId(),"goal",this.MapGoal.GetName(),"seconds",this.TCEHoldSeconds); }
};
this.Initialize = function()
{
    // Recheck during long RouteTo/Goto and while holding. A newly acquired
    // flag, bomb or urgent defuse must release this otherwise active priority.
    this.LimitTo(this.TCEActiveAllowed, 0.5, true);
};

this.GetPriority = function()
{
	Util.GetPriority(this, this.query, null, null, this.TCEEligible);
};

this.Enter = function()
{
	if(!this.MarkInProgress()) { this.Finished(); return; }
    this.TCETrace("BEGIN");
};

this.Exit = function()
{
    this.TCETrace("END");
	if (this.MapGoal)
	{
		kind=this.TCEGeneratedType(this.MapGoal,this.Bot);
		if (kind=="Defend" || kind=="Attack")
		{ this.TCEStationCycle+=1; this.TCEStationPicks={}; }
	}
	this.Bot.ReleaseButton(BTN.CROUCH, BTN.PRONE);

	// restore combat movement restrictions
	if (this.CombatMovementDisabled) {
		this.Bot.DisableCombatMovement = false;
		this.CombatMovementDisabled = false;
	}

	// restore weapon desirability
	wpn = this.DesirableWeapon;
	if (wpn) {
		this.DesirableWeapon = null;
		//command /bot reload_weapons causes error "getdot failed on null user type"
		wpn.PrimaryFire.DefaultDesirability = this.OldDesirability;
		this.OldDesirability = null;
		if (this.DisabledReload) {
			this.DisabledReload = false;
			wpn.PrimaryFire.IgnoreReload = false;
		}
	}
};

this.Update = function()
{
	Util.RouteTo(this);

	UsingWeapon = 0;
	IsSniper = null;

	if ( this.MapGoal.Weapons )
	{
		if (tableCount(this.MapGoal.Weapons) > 0)
		{
			UsingWeapon = this.Bot.HasAnyWeapon(this.MapGoal.Weapons, { CheckCharged=false, CheckAmmo=false });
			IsSniper = Util.IndexedSniperWeapons[UsingWeapon];
		}
	}
	else if (this.Debug)
	{
		print(this.MapGoal.GetName() + " has no Weapons Table");
	}

	if(this.Debug)
	{
		print("camp goal update", Util.WeaponName(UsingWeapon), UsingWeapon, IsSniper);
	}

	if (this.MapGoal.DisableCM > 0 && !this.Bot.DisableCombatMovement)
	{
		this.CombatMovementDisabled = true;
		this.Bot.DisableCombatMovement = true;
	}

	if (!this.DesirableWeapon)
	{
		wpn = UsingWeapon;
		if (!wpn) {
			wpn = ETUtil.GetBotPrimaryWeapon(this.Bot);
		}
		// AddWeaponRequest cannot be used because it ignores ammo and charge
		if (wpn) {
			weap = this.Bot.GetWeapon(wpn);
			if (weap) {
				this.OldDesirability = weap.PrimaryFire.DefaultDesirability;
				this.DesirableWeapon = weap;
				if (UsingWeapon) {
					weap.PrimaryFire.DefaultDesirability = 0.9;
					if (IsSniper && !weap.PrimaryFire.IgnoreReload) {
						weap.PrimaryFire.IgnoreReload = true;
						this.DisabledReload = true;
					}
				} else if(this.OldDesirability > 0) {
					weap.PrimaryFire.DefaultDesirability = this.OldDesirability + 0.15;
				}
			}
		}
	}

	peektime = 0;
	CampTime = RandFloat(this.MapGoal.MinCampTime, this.MapGoal.MaxCampTime);
    this.TCEHoldSeconds = CampTime;
    this.TCETrace("HOLD");
	for(timeout = 0; timeout < CampTime; timeout += 1)
	{
        if (!this.TCEActiveAllowed()) { this.Finished(); return; }
		if ( UsingWeapon && !this.Bot.HasAmmo(UsingWeapon) )
		{
			if(this.Debug)
			{
				print("camp goal has no ammo for", Util.WeaponName(UsingWeapon));
			}
			this.BlackboardDelay(20);
			this.Finished();
		}

		switch (this.MapGoal.Stance)
		{
			case "crouch":
			{
				this.Bot.HoldButton(BTN.CROUCH, 1.1);
			}
			case "prone":
			{
				this.Bot.HoldButton(BTN.PRONE, 1.1);
			}
			case "peek":
			{
				if ( timeout % RandInt(2,4) == 0 ) { // stand
					if ( peektime == 0 ) {
						peektime = timeout + this.Bot.ReactionTime + 1;
					}
				}
				else if ( timeout >= peektime ) { // hide
					peektime = 0;
					this.Bot.HoldButton(BTN.CROUCH, RandInt(1,3));
				}
			}
		}

		if ( IsSniper && this.Bot.GetCurrentWeapon()==UsingWeapon )
		{
			this.Bot.HoldButton(BTN.AIM,1.1);
		}

		this.AddAimRequest(Priority.Low, "facing", Util.GetRandomTableValue(this.MapGoal.AimVectors));

		sleep(1);
	}

	// don't choose the same camp spot
	this.BlackboardDelay(5);
	this.Finished();
};
