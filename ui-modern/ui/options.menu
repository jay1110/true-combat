#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpOptions"

// Macros //

#include "ui/modern_widgets.h"
		
// Options Menu //
	
menuDef {
	name		"options"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.55
	fadeAmount  0.075
	
	onESC {
		close options ;
#ifdef FUI
		open main
#else
		open ingame_main
#endif // FUI
	}
	onOpen {
#ifdef FUI
	//	setitemcolor background backcolor 0 0 0 0 ;
	//	fadein background
#else
// ydnar
		conditionalscript ROldModeCheck 2
			( "clearFocus ; open vid_confirm" )
			( "clearFocus" )
#endif // FUI
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.025 .035 .05 .97
		visible		1
		decoration
	}
// Window //

	WINDOW( "Options", 94 )
// modern settings desktop v1
    itemDef {
        name "modern_settings_card_0"
        rect 24 84 384 128
        style WINDOW_STYLE_FILLED
        backcolor .045 .065 .085 .98
        visible 1
        decoration
    }
