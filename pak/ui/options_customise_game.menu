#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpOptionsCustomiseGame"

// Macros //

#include "ui/modern_widgets.h"
		
// Customise Game Menu //
	
menuDef {
	name		"options_customise_game"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		close options_customise_game ;
		open options
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.025 .035 .05 .97
		visible		1
		decoration
	}
// Window //

	WINDOW( "Game Settings", 94 )
// modern settings desktop v1
    itemDef {
