#include "ui/menudef.h"
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 424
#define GROUP_NAME "grpModernBackgrounds"
#include "ui/modern_widgets.h"

menuDef {
    name "modern_backgrounds"
    visible 0
    fullscreen 0
    rect 0 20 852 424
    style WINDOW_STYLE_FILLED
    popup
    onESC { close modern_backgrounds ; open modern_appearance ; }
    WINDOW( "Backgrounds", 94 )

    MULTI( 32, 76, 788, 34, "Selection:", .25, 24, "ui_backgroundMode", cvarFloatList { "Season" 0 "Live weather (launcher)" 1 "Time of day only" 2 }, "Season is independent of online weather. Changes apply next game start." )
    EDITFIELD( 32, 130, 788, 32, "Country (ISO code):", .24, 23, "ui_backgroundCountry", 2, 2, "Examples: DE Germany, NZ New Zealand. Unknown/tropical countries have no automatic winter pictures." )
    EDITFIELD( 32, 184, 788, 32, "Winter months:", .24, 23, "ui_backgroundWinterMonths", 35, 35, "auto = country rule; none = no winter; or a comma list such as12,1,2 or6,7,8." )

    itemDef { name "background_help" rect 40 246 772 104
        text "Season: Germany uses December, January and February. Southern winter countries use June, July and August. Set none for a region without a snowy winter, or enter your own month numbers. These are seasonal pictures, not an observed snow report. Daylight pictures also vary with the time of day. Changes apply next game start."
        textfont UI_FONT_COURBD_21 textscale .23 textaligny 17
        forecolor .55 .64 .72 1 autowrapped visible 1 decoration }
    BUTTON( 24, 390, 186, 30, "BACK", .26, 21, close modern_backgrounds ; open modern_appearance ; )
    BUTTON( 230, 390, 230, 30, "RESET BACKGROUNDS", .24, 21,
        setcvar ui_backgroundMode 0 ; setcvar ui_backgroundCountry DE ; setcvar ui_backgroundWinterMonths auto ; )
}
