#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpCreditsIdSoftware"

// Macros //

#include "ui/modern_widgets.h"
		
// System Menu //
	
menuDef {
	name		"credits_idsoftware"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		close credits_idsoftware ;
		open main
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}
// Window //

	itemDef {
		name		"window"
		group		GROUP_NAME
		rect		0 0 WINDOW_WIDTH WINDOW_HEIGHT
		style		WINDOW_STYLE_FILLED
		backcolor	0 0 0 1
		border		WINDOW_BORDER_FULL
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}
    itemDef {
        name "modern_secondary_0"
        rect 24 60 176 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }

    itemDef {
        name "modern_secondary_1"
        rect 224 60 604 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }

	
// Logo //

	itemDef {
		name		"logoShadow"
		rect		49 105 128 128
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/logo_id"
		forecolor	0 0 0 1
		visible		1
		decoration
	}

	itemDef {
		name		"logo"
		rect		48 104 128 128
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/logo_id"
		forecolor	1 1 1 1
		visible		1
		decoration
	}
	
	itemDef {
		name		"headerLogo"
		group		GROUP_NAME
		rect		24 8 804 36
		text		"EXECUTIVE PRODUCED BY ID SOFTWARE"
		textfont	UI_FONT_ARIBLK_16
		textstyle	ITEM_TEXTSTYLE_NORMAL
		textscale	.40
		textalign	ITEM_ALIGN_LEFT
		textalignx	0
		textaligny	27
		forecolor	1 1 1 1
		visible		1
		decoration
	}
	
// Credits Sections //

#define CREDITS_Y	108
	
	LABELWHITE( 236, 98, 170, 18, "Kevin Cloud", .23, ITEM_ALIGN_RIGHT, 170, 14 )
	LABELWHITE( 426, 98, 390, 18, "Executive Producer", .23, ITEM_ALIGN_LEFT, 0, 14 )
	LABELWHITE( 236, 110, 170, 18, "Timothee Besset", .23, ITEM_ALIGN_RIGHT, 170, 14 )
	LABELWHITE( 426, 110, 390, 18, "Additional Programming", .23, ITEM_ALIGN_LEFT, 0, 14 )
	
// Copyright Notice //

	LABELWHITE( 236, 134, 580, 18, "Wolfenstein: Enemy Territory is powered by id Software's Quake III Arena (TM) technology.", .21, ITEM_ALIGN_LEFT, 0, 14 )
	LABELWHITE( 236, 146, 580, 18, "Production, development and technical assistance provided by id Software.", .21, ITEM_ALIGN_LEFT, 0, 14 )

// Buttons //

	BUTTON( 24, 442, 184, 28, "BACK", .28, 19, close credits_idsoftware ; open main )
	BUTTON( 364, 442, 252, 28, "SPLASH DAMAGE", .28, 19, close credits_idsoftware ; open credits_splashdamage )
	BUTTON( 638, 442, 190, 28, "ACTIVISION", .28, 19, close credits_idsoftware ; open credits_activision )
}
