include_guard(GLOBAL)
get_filename_component(TCE_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(TCE_VENDOR_DIR "${TCE_ROOT_DIR}/vendor")
set(TCE_NAVSTUDIO_DIR "${TCE_ROOT_DIR}/navstudio")
set(TCE_COMPAT_DIR "${TCE_ROOT_DIR}/compat")
set(TCE_PLATFORM_DIR "${TCE_ROOT_DIR}/platform")

option(FEATURE_OMNIBOT "Compile the server-side Omni-bot gameplay runtime bridge" ON)
option(FEATURE_LUA "Compile the server-side Lua scripting API" ON)
option(FEATURE_NAVSTUDIO "Compile local-only in-game authoring code (never public)" OFF)
option(TCE_BUILD_OMNIBOT_CORE "Build the matching Omni-bot gameplay runtime library" ${FEATURE_OMNIBOT})
option(TCE_BUILD_NAVSTUDIO "Expose the separate local NavStudio application targets" OFF)
option(TCE_BUILD_NAVMESH_TOOL "Build the separate local Recast geometry tool" OFF)
option(TCE_BUILD_TCE_HELPERS "Expose separate local TCE launcher/helper sources" OFF)
option(TCE_BUILD_REFERENCE_TESTS "Build historical Win32 original-DLL comparison tests" OFF)
option(TCE_ENABLE_SANITIZERS "Instrument mod libraries and deterministic smoke tests" OFF)
set(TCE_SANITIZERS "address,undefined" CACHE STRING "Clang/GCC sanitizer list")
set(TCE_ANDROID_API "23" CACHE STRING "Default Android API for supplied NDK toolchains")

if(FEATURE_NAVSTUDIO AND NOT FEATURE_OMNIBOT)
  message(FATAL_ERROR "NavStudio authoring requires FEATURE_OMNIBOT=ON; Game may explicitly disable the gameplay bridge")
endif()
if(FEATURE_OMNIBOT OR TCE_BUILD_OMNIBOT_CORE)
  enable_language(CXX)
endif()
if(NOT CMAKE_CONFIGURATION_TYPES AND NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()
set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
if(TCE_BUILD_REFERENCE_TESTS AND (NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 4))
  message(FATAL_ERROR "Historical reference tests require a Win32 MSVC-compatible compiler and local original DLLs")
endif()
