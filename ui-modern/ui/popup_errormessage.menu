#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpPopupError_pbenable"

// Macros //

#include "ui/modern_widgets.h"
		
// Error Popup //
	
menuDef {
	name		"popupError_pbenable"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.5
	fadeAmount  0.075
	
	onOpen {
		uiScript ServerStatus_diagnose ;
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
		
		conditionalScript cl_punkbuster 0
			( "hide bttn_pbenable" )
			( "show bttn_pbenable" )
	}
	
	onESC {
		uiScript clearError ;
		close popupError_pbenable ;
		open main
	}
	
// Background //

	itemDef {
		name		"background"
		rect		-5 -110 862 700
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 308
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 86

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "ERROR" )
	
	CVARLABEL( SUBWINDOW_X+24, SUBWINDOW_Y+60, SUBWINDOW_WIDTH-48, 132, "com_errorMessage", .26, ITEM_ALIGN_LEFT, 0, 15 )

	NAMEDBUTTON( "bttn_pbenable", SUBWINDOW_X+24, SUBWINDOW_Y+SUBWINDOW_HEIGHT-80, SUBWINDOW_WIDTH-48, 30, "ENABLE PUNKBUSTER", .30, 21, clearFocus ; open playonline_enablepb )	
	BUTTON( SUBWINDOW_X+24, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "BACK", .30, 21, uiScript clearError ; close popupError_pbenable ; open main )
	BUTTON( SUBWINDOW_X+230, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "RECONNECT", .30, 21, uiScript clearError ; close popupError_pbenable ; close backgroundmusic ; close background_1 ; uiScript reconnect )
    itemDef { name "modern_accent" rect 0 0 2 16 style WINDOW_STYLE_FILLED backcolor .94 .75 .27 .8 visible 1 decoration }
}
