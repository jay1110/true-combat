#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpProfileCreateError"

// Macros //

#include "ui/modern_widgets.h"
		
// Create Profile Menu //
	
menuDef {
	name		"profile_create_error"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	modal
	
	onESC {
		close profile_create_error ;
		open profile_create
	}
	
// Background //

	itemDef {
		name		"background"
		rect		-5 -110 862 700
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 280
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 100

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "CREATION ERROR" )
	CVARLABEL( SUBWINDOW_X+24, SUBWINDOW_Y+60, SUBWINDOW_WIDTH-48, 132, "ui_profile_create_error", .26, ITEM_ALIGN_LEFT, 0, 15 )
	
	BUTTON( SUBWINDOW_X+127, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "BACK", .30, 21, close profile_create_error )
}
