#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpViewReplay"

// Macros //

#include "ui/modern_widgets.h"
		
// View tcemods Menu //
	
menuDef {
	name		"tcemods"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.55
	fadeAmount  0.075
	
	onOpen {
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
	}
	
	onESC {
		close tcemods ;
		open main
	}
	
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Window //

WINDOW( "TC:E Mods", 126 )
itemDef { name "modern_tce_mode_card" rect 144 152 564 136
        style WINDOW_STYLE_FILLED backcolor .055 .075 .10 .96 visible 1 decoration }

MULTIACTION( 168, 204, 516, 32, "Switch to:", .30, 22, "ui_netGameType", cvarFloatList { "Capture The Flag" 2 "Objective" 5 "Bodycount" 7}, uiScript updateGameType, "Click to specify the type of game to load" )

// Buttons //
	BUTTON( 24, 442, 184, 28, "BACK", .28, 20, close tcemods; open main; )
	BUTTON( 638, 442, 190, 28, "OK", .28, 20, close tcemods; uiScript RunTCEMod )
    itemDef { name "modern_accent" rect 0 0 2 16 style WINDOW_STYLE_FILLED backcolor .94 .75 .27 .8 visible 1 decoration }
}
