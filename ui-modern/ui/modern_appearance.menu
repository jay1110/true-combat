#include "ui/menudef.h"
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 424
#define GROUP_NAME "grpModernAppearance"
#include "ui/modern_widgets.h"

menuDef {
    name "modern_appearance"
    visible 0
    fullscreen 0
    rect 0 20 852 424
    style WINDOW_STYLE_FILLED
    popup
    onESC { close modern_appearance ; open options ; }
    WINDOW( "Appearance", 94 )
    BUTTON( 704, 8, 124, 30, "BACK", .26, 21, close modern_appearance ; open options ; )

    MULTI( 32, 70, 378, 30, "Palette:", .23, 21, "ui_themePreset", cvarFloatList { "Gold" 0 "Arctic" 1 "Crimson" 2 "Emerald" 3 "Custom" 4 }, "Choose a palette or adjust the custom RGB values." )
    MULTI( 32, 108, 378, 30, "Transparency:", .23, 21, "ui_themeOpacityPreset", cvarFloatList { "Solid" 0 "Balanced" 1 "Glass" 2 "Custom" 3 }, "Transparency applies to menu surfaces, not text or the gameplay HUD." )
    SLIDER( 32, 146, 378, 30, "Custom opacity:", .23, 14, "ui_themeOpacity" .85 .25 1, "Used with Custom transparency. Higher values are more opaque." )
    SLIDER( 32, 202, 378, 30, "Menu size:", .23, 14, "ui_menuScale" 1 .5 1.25, "Menu size is independent of HUD size and always fits the screen." )
    SLIDER( 32, 240, 378, 30, "HUD size:", .23, 14, "cg_hudScale" .85 .5 1.25, "Adjust the gameplay HUD without moving menu windows." )
    itemDef { name "appearance_note" rect 40 290 354 40 text "Changes are applied immediately. Custom RGB values use the Custom palette." textfont UI_FONT_COURBD_21 textscale .21 textaligny 16 forecolor .55 .64 .72 1 autowrapped visible 1 decoration }
    BUTTON( 32, 354, 186, 30, "RESET APPEARANCE", .23, 21,
        setcvar ui_themePreset 0 ; setcvar ui_themeOpacityPreset 0 ; setcvar ui_themeOpacity .85 ;
        setcvar ui_themeAccentR .96 ; setcvar ui_themeAccentG .73 ; setcvar ui_themeAccentB .27 ;
        setcvar ui_themeBackgroundR .035 ; setcvar ui_themeBackgroundG .055 ; setcvar ui_themeBackgroundB .075 ;
        setcvar ui_menuScale 1 ; setcvar cg_hudScale .85 ; )

    itemDef { name "accent_title" rect 446 60 374 22 text "CUSTOM ACCENT / RGB" textfont UI_FONT_COURBD_21 textscale .22 textaligny 16 forecolor .94 .75 .27 1 visible 1 decoration }
    SLIDER( 442, 90, 378, 30, "Accent red:", .23, 14, "ui_themeAccentR" .96 0 1, "Custom accent red component." )
    SLIDER( 442, 128, 378, 30, "Accent green:", .23, 14, "ui_themeAccentG" .73 0 1, "Custom accent green component." )
    SLIDER( 442, 166, 378, 30, "Accent blue:", .23, 14, "ui_themeAccentB" .27 0 1, "Custom accent blue component." )
    itemDef { name "background_title" rect 446 224 374 22 text "CUSTOM SURFACE / RGB" textfont UI_FONT_COURBD_21 textscale .22 textaligny 16 forecolor .94 .75 .27 1 visible 1 decoration }
    SLIDER( 442, 254, 378, 30, "Surface red:", .23, 14, "ui_themeBackgroundR" .035 0 1, "Custom surface red component." )
    SLIDER( 442, 292, 378, 30, "Surface green:", .23, 14, "ui_themeBackgroundG" .055 0 1, "Custom surface green component." )
    SLIDER( 442, 330, 378, 30, "Surface blue:", .23, 14, "ui_themeBackgroundB" .075 0 1, "Custom surface blue component." )
}
