// Subwindows //

//#define SUBWINDOW_WIDTH		.5*(WINDOW_WIDTH-18)
#define SUBWINDOW_WIDTH		WINDOW_WIDTH-12
	
// Player //

	SUBWINDOW( 24, 60, 256, 56, "Player" )
	EDITFIELD( 32, 78, 240, 34, "Player Alias:", .22, 14, "name", 36, 18, "Enter the name that you wish to be known by to others on servers" )
	
// Physics //

	SUBWINDOW( 24, 144, 256, 90, "Physics" )
	YESNO( 32, 162, 240, 34, "Always Run:", .22, 14, "cl_run", "" )
	MULTI( 32, 196, 240, 34, "Double-Tap Prone:", .22, 14, "cl_doubletapdelay", cvarFloatList { "Yes" 350 "No" 0 }, "" )
	
// Weapons //

