# Only source and this repository policy belong in future commits.
/*
!/.gitignore
!/src/

# Publish production sources and build inputs only. Local research is retained.
/src/*
!/src/botai/
!/src/cgame/
!/src/game/
!/src/server/
!/src/ui/
!/src/cmake/
!/src/CMakeLists.txt
!/src/build.ps1
!/src/BUILDING.md
!/src/SConstruct
!/src/SConscript.*
!/src/scons_utils.py
!/src/cross-scons.sh
!/src/makebundle.sh
!/src/wolf.sln
/src/botai/**
/src/cgame/**
/src/game/**
/src/server/**
/src/ui/**
!/src/**/
!/src/**/*.c
!/src/**/*.cpp
!/src/**/*.h
!/src/**/*.inc
!/src/**/*.def
!/src/**/*.vcproj
!/src/**/*.dsp

# Vendored Omni-bot production sources, build inputs and attribution only.
!/src/vendor/
/src/vendor/**
!/src/vendor/**/
!/src/vendor/**/*.c
!/src/vendor/**/*.cpp
!/src/vendor/**/*.h
!/src/vendor/**/*.inl
!/src/vendor/**/*.mcr
!/src/vendor/**/*.rc
!/src/vendor/**/CMakeLists.txt
!/src/vendor/**/*.cmake
!/src/vendor/**/*.in
!/src/vendor/**/IMPORT-NOTICE.txt
!/src/vendor/**/LICENSE*
!/src/vendor/luasql/license.html
!/src/vendor/**/COPYING*
!/src/vendor/**/COPYRIGHT*
!/src/vendor/**/LGPL.txt
!/src/vendor/**/CREDITS.txt
!/src/vendor/**/README*
/src/cmake/*
!/src/cmake/*.cmake
# Overrides the source-extension exceptions above for local-only work.
/src/tests/
/src/tools/
/src/reconstruction/
/src/AGENTS.md

# Generated files stay local even when building inside src.
**/__pycache__/
**/*.py[cod]
**/build/
**/Debug/
**/Release/
**/CMakeFiles/
**/CMakeCache.txt
**/Testing/
**/.vs/
**/*.obj
**/*.o
**/*.dll
**/*.so
**/*.exe
**/*.pdb
**/*.ilk
**/*.exp
**/*.lib
**/*.suo
**/*.user

