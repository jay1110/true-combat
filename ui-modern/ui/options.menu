#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 104
#define GROUP_NAME		"grpOptions"

// Macros //

#include "ui/modern_widgets.h"
		
// Options Menu //
// modern settings desktop v1
	
menuDef {
	name		"options"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.55
	fadeAmount  0.075
	
	onESC {
		close options ;
#ifdef FUI
		open main
#else
		open ingame_main
#endif // FUI
	}
	onOpen {
#ifdef FUI
	//	setitemcolor background backcolor 0 0 0 0 ;
	//	fadein background
#else
// ydnar
		conditionalscript ROldModeCheck 2
			( "clearFocus ; open vid_confirm" )
			( "clearFocus" )
#endif // FUI
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 104
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}
// Window //

	WINDOW( "Options", 94 )
	
// Buttons //

	BUTTON( 24, 56, 124, 32, "GAME", .27, 22, close options ; open options_customise_game )
	BUTTON( 160, 56, 124, 32, "VIEW", .27, 22, close options ; open options_customise_hud )
	BUTTON( 296, 56, 124, 32, "CONTROLS", .27, 22, close options ; open options_controls )
	BUTTON( 432, 56, 124, 32, "SYSTEM", .27, 22, close options ; open options_system )
#ifdef FUI
	BUTTON( 704, 56, 124, 32, "BACK", .27, 22, close options ; open main )
#else
	BUTTON( 704, 56, 124, 32, "BACK", .27, 22, close options ; open ingame_main )
#endif // FUI

itemDef {
        name "modern_appearance_link"
        rect 568 56 124 32
        text "APPEARANCE"
        textfont UI_FONT_ARIBLK_27
        textscale .27
        textalign ITEM_ALIGN_CENTER textalignx 62 textaligny 22
        type ITEM_TYPE_BUTTON
        style WINDOW_STYLE_FILLED backcolor .10 .14 .19 .96
        forecolor .84 .88 .92 1
        border WINDOW_BORDER_FULL bordercolor .23 .29 .35 .75
        visible 1
        action { close options ; open modern_appearance ; }
    }
}
