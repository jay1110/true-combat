#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpVidConfirm"

// Macros //

#include "ui/modern_widgets.h"
		
// Confirm Video Mode Menu //
	
menuDef
{
	name		"vid_confirm"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	modal
	alwaysontop
	
	fadeClamp	0.5
	fadeAmount  0.075
	
	onOpen
	{
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
	}
	
	onESC
	{
		uiScript VidReset ;
		exec "vid_restart" 
	}
	
	// after 15 seconds, reset to previous video mode
	onTimeout 15000
	{
		uiScript VidReset ;
		exec "vid_restart" 
	}
	
// Background //

	itemDef {
		name		"background"
		rect		-5 -110 862 700
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 180
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 150

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "CONFIRM VIDEO CHANGE" )
/*	LABEL( SUBWINDOW_X+2, SUBWINDOW_Y+16, (SUBWINDOW_WIDTH)-8, 10,
		"Use this video mode?\nReverting to previous\nsetting in 15 seconds...",
		.2, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-4), 8 )

#define COUNTER_WIDTH		32
	itemDef
	{
		name			"mapPreview"
		group			GROUP_NAME
		rect			$evalfloat((SUBWINDOW_X)+(SUBWINDOW_WIDTH)-COUNTER_WIDTH-4) $evalfloat((SUBWINDOW_Y)+2) $evalfloat((COUNTER_WIDTH)) 12
		type			ITEM_TYPE_TIMEOUT_COUNTER
		text			" "	// filler, must be present
		textfont		UI_FONT_ARIBLK_16
		textscale		.19
		textalign		ITEM_ALIGN_RIGHT
		textalignx		COUNTER_WIDTH	//%	3
		textaligny		10
		border			WINDOW_BORDER_NONE
		style			WINDOW_STYLE_EMPTY
		forecolor		.84 .88 .92 1
		visible			1
		decoration
    }*/
    
    LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+52, SUBWINDOW_WIDTH-48, 18, "Use this video mode?", .26, ITEM_ALIGN_LEFT, 0, 15 )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+71, SUBWINDOW_WIDTH-48, 18, "Reverting to previous", .26, ITEM_ALIGN_LEFT, 0, 15 )
    
    itemDef {
		name			"labelConfirmCounter"
      	group			GROUP_NAME
		rect			$evalfloat(SUBWINDOW_X+24) $evalfloat(SUBWINDOW_Y+92) $evalfloat(SUBWINDOW_WIDTH-48) 20
		type			ITEM_TYPE_TIMEOUT_COUNTER
		text			"setting in %s seconds..."
		textfont		UI_FONT_COURBD_21
		textstyle		ITEM_TEXTSTYLE_NORMAL
		textscale		.26
		textalign		ITEM_ALIGN_LEFT
		textalignx		0
		textaligny		15
		forecolor		.84 .88 .92 1
		visible			1
		decoration
    }
	
#ifdef FUI
	BUTTON( SUBWINDOW_X+24, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "YES", .30, 21, uiScript vidConfirm ; close vid_confirm ; open main )
#else
	BUTTON( SUBWINDOW_X+24, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "YES", .30, 21, uiScript vidConfirm ; close vid_confirm ; open ingame_main )
#endif // FUI
	BUTTON( SUBWINDOW_X+230, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "NO", .30, 21, uiScript vidReset ; exec "vid_restart" )
}
