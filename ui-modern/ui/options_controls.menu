itemDef {
            name "modern_nav_game" rect 252 12 112 30
            text "GAME" textfont UI_FONT_ARIBLK_27 textscale .25
            textalign ITEM_ALIGN_CENTER textalignx 56 textaligny 21
            style WINDOW_STYLE_FILLED
            border WINDOW_BORDER_FULL bordercolor .23 .29 .35 .75
            backcolor .08 .12 .16 1
            forecolor .84 .89 .94 1
            visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_nav_game" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_game" forecolor 1 1 1 1 ; setitemcolor "modern_nav_game" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_nav_game" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_game" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_game" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_nav_game" backcolor .19 .26 .33 1 ; setitemcolor "modern_nav_game" forecolor 1 1 1 1 ; setitemcolor "modern_nav_game" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_nav_game" backcolor .08 .12 .16 1 ; setitemcolor "modern_nav_game" forecolor .84 .89 .94 1 ; setitemcolor "modern_nav_game" bordercolor .23 .29 .35 .75 ; }
 action { close options_controls ; open options ; close options ; open options_customise_game }
        }
