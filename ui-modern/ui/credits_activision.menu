#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpCreditsActivision"

// Macros //

#include "ui/modern_widgets.h"
		
// System Menu //
	
menuDef {
	name		"credits_activision"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		close credits_activision ;
		open main
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}
// Window //

	itemDef {
		name		"window"
		group		GROUP_NAME
		rect		0 0 WINDOW_WIDTH WINDOW_HEIGHT
		style		WINDOW_STYLE_FILLED
		backcolor	0 0 0 1
		border		WINDOW_BORDER_FULL
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}
    itemDef {
        name "modern_secondary_0"
        rect 24 60 176 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }

    itemDef {
        name "modern_secondary_1"
        rect 224 60 604 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }

	
// Logo //

	itemDef {
		name		"logoShadow"
		rect		37 129 152 38
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/logo_atvi"
		forecolor	0 0 0 1
		visible		1
		decoration
	}

	itemDef {
		name		"logo"
		rect		36 128 152 38
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/logo_atvi"
		forecolor	1 1 1 1
		visible		1
		decoration
	}
	
	itemDef {
		name		"headerLogo"
		group		GROUP_NAME
		rect		24 8 804 36
		text		"PRODUCED BY ACTIVISION"
		textfont	UI_FONT_ARIBLK_16
		textstyle	ITEM_TEXTSTYLE_NORMAL
		textscale	.40
		textalign	ITEM_ALIGN_LEFT
		textalignx	0
		textaligny	27
		forecolor	1 1 1 1
		visible		1
		decoration
	}
	
