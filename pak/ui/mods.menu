// $Id: mods.menu,v 1.1.2.2 2004/03/14 02:47:52 rain Exp $

// rain - hacked the demo menu into a mods menu
#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
//#define WINDOW_WIDTH	400
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpMods"

// Macros //

#include "ui/modern_widgets.h"

// View Mods Menu //
	
menuDef {
	name		"mods"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onOpen {
		uiScript LoadMods
	}

	onESC {
		close mods ;
		open main
	}

// Window //

	WINDOW( "MODS", 150 )

// Demo List //

	itemDef {
		name			"modList"
		group			GROUP_NAME
		rect			24 66 804 350
		type			ITEM_TYPE_LISTBOX
		textfont		UI_FONT_COURBD_21
		textscale		.28
		textaligny		-2
		forecolor		.88 .91 .94 1
		outlinecolor	.5 .5 .5 .4
		border			WINDOW_BORDER_FULL
		bordercolor		.23 .29 .35 .75
		feeder			FEEDER_MODS
		elementtype		LISTBOX_TEXT
		elementwidth	780
		elementheight	26
		columns 1 0 780 33
		visible			1
		tooltip			"Select the modification to play"
		
		doubleClick {
			uiScript RunMod
		}
		backcolor	.055 .075 .10 .94
	}
	
// Buttons //

	BUTTON( 24, 442, 184, 28, "BACK", .28, 20, close mods ; open main )
	BUTTON( 638, 442, 190, 28, "LOAD MOD", .28, 20, uiScript RunMod )
}
