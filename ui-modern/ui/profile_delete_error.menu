#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpProfileDeleteError"

// Macros //

#include "ui/modern_widgets.h"
		
// Delete Profile Menu //
	
menuDef {
	name		"profile_delete_error"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	onESC {
		close profile_delete_error ;
		open profile_sub
	}
	
// Background //

	itemDef {
		name		"background"
		rect		-5 -110 862 700
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 180
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 150

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "DELETE WARNING" )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+52, SUBWINDOW_WIDTH-48, 18, "Can't delete", .26, ITEM_ALIGN_LEFT, 0, 15 )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+71, SUBWINDOW_WIDTH-48, 18, "active profile.", .26, ITEM_ALIGN_LEFT, 0, 15 )
	
	BUTTON( SUBWINDOW_X+127, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "BACK", .30, 21, close profile_delete_error ; open profile_sub )
}
