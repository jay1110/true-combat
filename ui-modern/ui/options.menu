// Buttons //

	BUTTON( 24, 84, 384, 128, "GAME", .46, 75, close options ; open options_customise_game )
	BUTTON( 444, 84, 384, 128, "VIEW", .46, 75, close options ; open options_customise_hud )
	BUTTON( 24, 252, 384, 128, "CONTROLS", .46, 75, close options ; open options_controls )
	BUTTON( 444, 252, 384, 128, "SYSTEM", .46, 75, close options ; open options_system )
#ifdef FUI
	BUTTON( 24, 442, 180, 26, "BACK", .27, 18, close options ; open main )
#else
	BUTTON( 24, 442, 180, 26, "BACK", .27, 18, close options ; open ingame_main )
#endif // FUI

