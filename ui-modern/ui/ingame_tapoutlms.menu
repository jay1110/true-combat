#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"tapoutgrplms"

// Macros //

#include "ui/modern_widgets.h"
		
menuDef
{
	name		"tapoutmsglms"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.5
	
	onOpen	
	{	
		setfocus tapoutyesbtnlms
	}
	
	onESC
	{
		close tapoutmsg;
	}
	
// Background //

	itemDef {
		name		"background"
		rect		-5 -5 862 490
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 804
#define SUBWINDOW_HEIGHT 180
#define SUBWINDOW_X 24
#define SUBWINDOW_Y 150

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "Respawning" )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+52, SUBWINDOW_WIDTH-48, 18, "You are playing in a single-man objective game and must wait for the next round to respawn. Click OKAY to spectate any remaining players.", .25, ITEM_ALIGN_LEFT, 0, 15 )
	
	NAMEDBUTTON( "tapoutyesbtnlms", SUBWINDOW_X+307, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "OKAY", .30, 21, exec forcetapout ; close tapoutmsglms )
    itemDef { name "modern_accent" rect 0 0 2 16 style WINDOW_STYLE_FILLED backcolor .94 .75 .27 .8 visible 1 decoration }
}
	