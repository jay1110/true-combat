#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpProfile"

// Macros //

#include "ui/modern_widgets.h"

// Profile Menu //
	
menuDef {
	name		"profile"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.55
	fadeAmount  0.075
	
	onOpen {
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
		uiScript loadProfiles
	}

	onESC {
		close profile ;
		open main
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}
// Window //

	WINDOW( "Profile", 90 )
    itemDef {
        name "modern_browse_card_0"
        rect 24 60 510 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }
    itemDef {
        name "modern_browse_card_1"
        rect 558 60 270 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }


// Profile List //

	itemDef {
		name			"profileList"
		group			GROUP_NAME
		rect			36 76 486 340
		type			ITEM_TYPE_LISTBOX
		textfont		UI_FONT_COURBD_21
		textscale		.30
		textaligny		-2
		forecolor		.88 .91 .94 1
		outlinecolor	.94 .75 .27 .20
		border			WINDOW_BORDER_FULL
		bordercolor		.23 .29 .35 .75
		feeder			FEEDER_PROFILES
		elementtype		LISTBOX_TEXT
		elementwidth	470
		elementheight	28
		columns			1 0 470 33
		visible			1
		tooltip			""
		
		doubleClick {
			conditionalscript ui_profile 1
				// Load the cached servers before the vid_restart (which saves the cached servers),
				// ui_profile is set so servers will be loaded from profile directory
				( "close profile ; uiscript clearPID ; uiscript applyProfile ; execwolfconfig 1 ; uiscript loadCachedServers ; exec vid_restart" )
				( "open profile_sub" )
		}
		backcolor	.055 .075 .10 .94
	}
	
// Buttons //

	BUTTON( 574, 92, 238, 36, "CREATE", .30, 25, close profile ; open profile_create )
	BUTTON( 574, 142, 238, 36, "DELETE", .30, 25, close profile ; conditionalscript UIProfileIsActiveProfile 2
																				( "open profile_delete_error" )
																				( "open profile_delete" ) )
	BUTTON( 574, 192, 238, 36, "RENAME", .30, 25, close profile ; open profile_rename )
	BUTTON( 574, 242, 238, 36, "SET AS DEFAULT", .30, 25, conditionalscript ui_profile 1
																			( "uiscript setDefaultProfile" )
																			( "open profile_sub" ) )

	BUTTON( 24, 442, 184, 28, "BACK", .30, 20, close profile ; open main )
	BUTTON( 638, 442, 190, 28, "SELECT PROFILE", .30, 20, conditionalscript ui_profile 1
																												// Load the cached servers before the vid_restart (which saves the cached servers),
																												// ui_profile is set so servers will be loaded from profile directory
																												( "close profile ; uiscript clearPID ; uiscript applyProfile ; execwolfconfig 1 ; uiscript loadCachedServers ; exec vid_restart" )
																												( "open profile_sub" ) )
}
