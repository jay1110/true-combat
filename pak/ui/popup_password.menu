#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpPopupPassword"

// Macros //

#include "ui/modern_widgets.h"
		
// Password Popup //
	
menuDef {
	name		"popupPassword"
	visible		0
	fullscreen	1
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.5
	fadeAmount  0.075
	
	onOpen {
		close fadebox_black ;
		close background_1 ;
		close backgroundmusic ;
		close main ;
		uiScript ServerStatus_diagnose ;
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background ;
	// ELITE no sound	playlooped "sound/music/menu_server.wav"
		setEditFocus "efleftPassword:"
	}
	
	onESC {
		uiScript clearError ;
		close popupPassword ;
		open main
	}
	
	onEnter	{
		conditionalscript password 1
			( "uiScript clearError ; close popupPassword ; uiScript reconnect" )
			( "setFocus efleftPassword:" )
	}
	
// Background //

	itemDef {
		name		"loadPanel"
		rect		0 0 852 480
		type		ITEM_TYPE_OWNERDRAW
		ownerdraw	UI_LOADPANEL
		visible		1
		decoration
	}

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 180
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 150

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "PASSWORD REQUIRED" )

	itemDef {
		name		"efleftbackPassword:"
		group		GROUP_NAME
		rect		288 216 336 28
		style		WINDOW_STYLE_FILLED
		backcolor	.075 .105 .14 .98
		visible		1
		decoration
		border	WINDOW_BORDER_FULL
		bordercolor	.35 .32 .22 .85
	}
	EDITFIELDLEFT( 228, 216, 396, 28, "Password:", .26, 20, "password", 32, 25, "" )
	
	BUTTON( 228, 288, 190, 30, "BACK", .30, 21, uiScript clearError ; close popupPassword ; open main_opener )
	BUTTON( 434, 288, 190, 30, "CONNECT", .30, 21, conditionalscript password 1
																																		( "uiScript clearError ; close popupPassword ; uiScript reconnect" )
																																		( "clearFocus" ) )
}
