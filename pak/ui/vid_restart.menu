#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpVidRestart"

// Macros //

#include "ui/modern_widgets.h"
		
// Restart Video Mode Menu //
	
menuDef
{
	name		"vid_restart"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.5
	
	onOpen
	{
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
	}
	
	onESC
	{
		close vid_restart ;
		open options_system
	}
	
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 180
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 150

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "CHANGE VIDEO SETTINGS" )
#ifdef FUI
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+52, SUBWINDOW_WIDTH-48, 18, "Apply new settings and\nreturn to the main menu?", .26, ITEM_ALIGN_LEFT, 0, 15 )
#else
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+71, SUBWINDOW_WIDTH-48, 18, "Apply new settings and\nreturn to the in-game menu?", .26, ITEM_ALIGN_LEFT, 0, 15 )
#endif // FUI
	
	BUTTON( SUBWINDOW_X+24, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "YES", .30, 21, uiScript systemCvarsApply ; close vid_restart ; exec "vid_restart" )
	BUTTON( SUBWINDOW_X+230, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "NO", .30, 21, close vid_restart ; open options_system )
    itemDef { name "modern_accent" rect 0 0 2 16 style WINDOW_STYLE_FILLED backcolor .94 .75 .27 .8 visible 1 decoration }
}
