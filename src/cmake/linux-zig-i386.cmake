set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR i386)
if(NOT DEFINED TCE_ZIG_EXECUTABLE)
  message(FATAL_ERROR "Set TCE_ZIG_EXECUTABLE to a Zig compiler executable")
endif()
set(CMAKE_C_COMPILER "${TCE_ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 "cc -target x86-linux-gnu.2.17")
set(CMAKE_CXX_COMPILER "${TCE_ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 "c++ -target x86-linux-gnu.2.17")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TCE_ZIG_EXECUTABLE)
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/linux-zig-rules.cmake")
