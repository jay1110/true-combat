#include "ui/menudef.h"

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME "grpMessageMode"

#include "ui/menumacros.h"

// Keep the stock message lifecycle and item names. The original ten-unit
// text rows cannot hold readable glyphs when the user reduces menu size.
#define SUBWINDOW_WIDTH 600
#define SUBWINDOW_HEIGHT 188
#define SUBWINDOW_X .5*(WINDOW_WIDTH-SUBWINDOW_WIDTH)
#define SUBWINDOW_Y .5*(WINDOW_HEIGHT-SUBWINDOW_HEIGHT)

menuDef {
    name "ingame_messagemode"
    visible 0
    fullscreen 0
    rect WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
    style WINDOW_STYLE_FILLED

    onOpen {
        closeAllOtherMenus ;
        setEditFocus "efleftSay:"
    }
    onESC { close ingame_messagemode ; }
    onEnter {
        close ingame_messagemode ;
        exec messageSend ;
    }

    itemDef {
        name "subwindowblackSEND MESSAGE"
        group GROUP_NAME
        rect $evalfloat(SUBWINDOW_X) $evalfloat(SUBWINDOW_Y) SUBWINDOW_WIDTH SUBWINDOW_HEIGHT
        style WINDOW_STYLE_FILLED
        backcolor .055 .075 .10 .97
        border WINDOW_BORDER_FULL
        bordercolor .23 .29 .35 .75
        visible 1
        decoration
    }
    itemDef {
        name "subwindowblacktitleSEND MESSAGE"
        group GROUP_NAME
        rect $evalfloat(SUBWINDOW_X+16) $evalfloat(SUBWINDOW_Y+10) $evalfloat(SUBWINDOW_WIDTH-32) 28
        text "SEND MESSAGE"
        textfont UI_FONT_ARIBLK_16
        textscale .32
        textalignx 0
        textaligny 22
        forecolor .94 .75 .27 1
        visible 1
        decoration
    }
    itemDef {
        name "efleftbackSay:"
        group GROUP_NAME
        rect $evalfloat(SUBWINDOW_X+16) $evalfloat(SUBWINDOW_Y+50) $evalfloat(SUBWINDOW_WIDTH-32) 36
        style WINDOW_STYLE_FILLED
        backcolor .10 .14 .19 .96
        visible 1
        decoration
    }
    EDITFIELDLEFT( SUBWINDOW_X+16, SUBWINDOW_Y+50, SUBWINDOW_WIDTH-32, 36,
        "Say:", .28, 26, "cg_messageText" onEsc { close ingame_messagemode }, 128, 128,
        "Enter text here - press ESCAPE twice to cancel" )

    MULTILEFT( SUBWINDOW_X+16, SUBWINDOW_Y+94, SUBWINDOW_WIDTH-32, 30,
        "To:", .26, 22, "cg_messageType", cvarFloatList { "All" 1 "Team" 2 "Fireteam" 3 },
        "Select the desitnation for your text (To all, team only or fire-team only)" )

    BUTTON( SUBWINDOW_X+16, SUBWINDOW_Y+146, .5*(SUBWINDOW_WIDTH-48), 30,
        "CANCEL", .30, 22, close ingame_messagemode ; )
    BUTTON( SUBWINDOW_X+32+.5*(SUBWINDOW_WIDTH-48), SUBWINDOW_Y+146, .5*(SUBWINDOW_WIDTH-48), 30,
        "SEND", .30, 22, close ingame_messagemode ; exec messageSend ; )
}
