{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/modern/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "FEATURE_OMNIBOT": "ON",
        "FEATURE_NAVSTUDIO": "OFF",
        "TCE_BUILD_REFERENCE_TESTS": "OFF",
        "TCE_BUILD_OMNIBOT_CORE": "ON"
      }
    },
    {
      "name": "linux-clang-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-clang-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang-asan",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "TCE_ENABLE_SANITIZERS": "ON",
        "TCE_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "windows-msvc-win32",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "windows-msvc-x64",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "windows-msvc-asan",
      "inherits": "windows-msvc-x64",
      "cacheVariables": {
        "TCE_ENABLE_SANITIZERS": "ON",
        "TCE_SANITIZERS": "address"
      }
    },
    {
      "name": "windows-clang-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "linux-i386-zig",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-i386-zig.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "linux-x86_64-zig",
