#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpIngameVoteMisc"

// Macros //

#include "ui/modern_widgets.h"

// Misc Vote Menu //

menuDef {
	name		"ingame_vote_misc"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED

	onOpen {
		//copyCvar g_gametype ui_netgametype ;
		
		conditionalScript g_gametype 3	// 3: cvartest
			( "hide bttn_nextmap ; show bttn_nextcampaign" )
			( "show bttn_nextmap ; hide bttn_nextcampaign" ) "4" ;

		copyCvar g_gametype ui_voteGameType ;

		conditionalScript ui_voteGameType 3	// 3: cvartest
			( "setcvar ui_voteGameType 2" )
			( "clearFocus" ) "4" ;

	}

	onEsc {
		close ingame_vote_misc ;
		open ingame_vote
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}
// Window //

	WINDOW( "Misc.", 50)
    itemDef {
        name "modern_secondary_0"
        rect 572 248 256 68
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }


// Buttons //

	BUTTON( 24, 72, 256, 68, "START MATCH", .30, 46, exec "cmd callvote startmatch"; uiScript closeingame )
	BUTTONEXT( 298, 72, 256, 68, "RESET MATCH", .30, 46, exec "cmd callvote matchreset"; uiScript closeingame, voteFlag CV_SVF_MATCHRESET )
	BUTTON( 572, 72, 256, 68, "RESTART MAP", .30, 46, exec "cmd callvote maprestart"; uiScript closeingame )
	NAMEDBUTTONEXT( bttn_nextmap, 24, 160, 256, 68, "NEXT MAP", .30, 46, exec "cmd callvote nextmap"; uiScript closeingame, settingEnabled CV_SVS_NEXTMAP voteFlag CV_SVF_NEXTMAP )
//	NAMEDBUTTONEXT( bttn_nextcampaign, 6, 86, .5*(WINDOW_WIDTH-18), 14, "NEXT CAMPAIGN", .24, 11, exec "cmd callvote nextmap"; uiScript closeingame, settingEnabled CV_SVS_NEXTMAP voteFlag CV_SVF_NEXTMAP )
	BUTTONEXT( 24, 248, 256, 68, "ANTI-LAG ON", .30, 46, exec "cmd callvote antilag 1"; uiScript closeingame, settingDisabled CV_SVS_ANTILAG voteFlag CV_SVF_ANTILAG )
	BUTTONEXT( 24, 248, 256, 68, "ANTI-LAG OFF", .30, 46, exec "cmd callvote antilag 0"; uiScript closeingame, settingEnabled CV_SVS_ANTILAG voteFlag CV_SVF_ANTILAG )

//	BUTTONEXT( 6+.5*(WINDOW_WIDTH-18)+6, 32, .5*(WINDOW_WIDTH-18), 14, "XP SHUFFLE", .24, 11, exec "cmd callvote shuffleteamsxp"; uiScript closeingame, voteFlag CV_SVF_SHUFFLETEAMS )
	BUTTONEXT( 298, 160, 256, 68, "SWAP TEAMS", .30, 46, exec "cmd callvote swapteams"; uiScript closeingame, voteFlag CV_SVF_SWAPTEAMS )
	BUTTONEXT( 572, 160, 256, 68, "MUTE SPECS", .30, 46, exec "cmd callvote mutespecs 1"; uiScript closeingame, settingDisabled CV_SVS_MUTESPECS voteFlag CV_SVF_MUTESPECS )
	BUTTONEXT( 572, 160, 256, 68, "UNMUTE SPECS", .30, 46, exec "cmd callvote mutespecs 0"; uiScript closeingame, settingEnabled CV_SVS_MUTESPECS voteFlag CV_SVF_MUTESPECS )
//	BUTTONEXT( 6+.5*(WINDOW_WIDTH-18)+6, 86, .5*(WINDOW_WIDTH-18), 14, "FRIENDLY FIRE ON", .24, 11, exec "cmd callvote friendlyfire 1"; uiScript closeingame, settingDisabled CV_SVS_FRIENDLYFIRE voteFlag CV_SVF_FRIENDLYFIRE )
//	BUTTONEXT( 6+.5*(WINDOW_WIDTH-18)+6, 86, .5*(WINDOW_WIDTH-18), 14, "FRIENDLY FIRE OFF", .24, 11, exec "cmd callvote friendlyfire 0"; uiScript closeingame, settingEnabled CV_SVS_FRIENDLYFIRE voteFlag CV_SVF_FRIENDLYFIRE )
	BUTTONEXT( 298, 248, 256, 68, "BALANCED TEAMS ON", .30, 46, exec "cmd callvote balancedteams 1"; uiScript closeingame, settingDisabled CV_SVS_BALANCEDTEAMS voteFlag CV_SVF_BALANCEDTEAMS )
	BUTTONEXT( 298, 248, 256, 68, "BALANCED TEAMS OFF", .30, 46, exec "cmd callvote balancedteams 0"; uiScript closeingame, settingEnabled CV_SVS_BALANCEDTEAMS voteFlag CV_SVF_BALANCEDTEAMS )

//	BUTTONEXT( 6, 122, WINDOW_WIDTH-12, 14, "COMPETITION SETTINGS", .24, 11, exec "cmd callvote comp"; uiScript closeingame, voteFlag CV_SVF_COMP )
//	BUTTONEXT( 6, 140, WINDOW_WIDTH-12, 14, "PUBLIC SETTINGS", .24, 11, exec "cmd callvote pub"; uiScript closeingame, voteFlag CV_SVF_PUB )

//	MULTILEFT( 8, 158+2, .66*(WINDOW_WIDTH-18), 10, "Warmup Damage:", .2, 8, "ui_voteWarmupDamage", cvarFloatList { "None" 0 "Enemies" 1 "Everyone" 2 } voteFlag CV_SVF_WARMUPDAMAGE, "Select the warm-up damage mode to vote on" )
//	NAMEDBUTTONEXT( "bttnextWarmupDamage", 6+.80*(WINDOW_WIDTH-18)+6, 158, .20*(WINDOW_WIDTH-18), 14, "OK", .24, 11, uiScript voteWarmupDamage; uiScript closeingame, voteFlag CV_SVF_WARMUPDAMAGE )

	itemDef {
		name		"nfleftbackTimelimit:"
		group		GROUP_NAME
		rect		644 272 90 24
		style		WINDOW_STYLE_FILLED
		backcolor	.12 .17 .22 .96
		visible		1
		voteFlag	CV_SVF_TIMELIMIT
		decoration
	}
	NUMERICFIELDLEFTEXT( 588, 272, 146, 24, "Time Limit:", .22, 17, "ui_voteTimelimit", 6, voteFlag CV_SVF_TIMELIMIT, "Specify a time limit to vote on" )
	NAMEDBUTTONEXT( "bttnextTimelimit", 746, 264, 66, 36, "OK", .28, 24, uiScript voteTimelimit; uiScript closeingame, voteFlag CV_SVF_TIMELIMIT )

//	MULTILEFT( 8, 194+2, .66*(WINDOW_WIDTH-18), 10, "Game Type:", .2, 8, "ui_voteGameType", cvarFloatList { "Single-Map Objective" 2 "Stopwatch" 3 "Last Man Standing" 5 } voteflag CV_SVF_GAMETYPE, "Select the game type to vote on" )
//	MULTILEFT( 8, 194+2, .66*(WINDOW_WIDTH-18), 10, "Game Type:", .2, 8, "ui_voteGameType", cvarFloatList { "Objective" 5 "Reinforced Objective" 2 "Bodycount" 7 } voteflag CV_SVF_GAMETYPE, "Select the game type to vote on" )
	
//	NAMEDBUTTONEXT( "bttnextGameType", 6+.80*(WINDOW_WIDTH-18)+6, 194, .20*(WINDOW_WIDTH-18), 14, "OK", .24, 11, uiScript voteGame; uiScript closeingame, voteflag CV_SVF_GAMETYPE )

	BUTTON( 24, 442, 184, 28, "BACK", .28, 19, close ingame_vote_misc ; open ingame_vote )

itemDef { name "modern_vote_nav_misc" rect 398 12 138 30
                text "MISC" textfont UI_FONT_ARIBLK_27 textscale .25
                textalign ITEM_ALIGN_CENTER textalignx 69 textaligny 21
                style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL
                bordercolor .23 .29 .35 .75
                backcolor .94 .75 .27 1
                forecolor .025 .035 .05 1
                visible 1 decoration
            }
itemDef { name "modern_vote_nav_map_0" rect 544 12 138 30
                text "MAP" textfont UI_FONT_ARIBLK_27 textscale .25
                textalign ITEM_ALIGN_CENTER textalignx 69 textaligny 21
                style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL
                bordercolor .23 .29 .35 .75
                backcolor .08 .12 .16 1
                forecolor .84 .89 .94 1
                visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_vote_nav_map_0" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_map_0" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_map_0" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_vote_nav_map_0" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_map_0" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_map_0" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_vote_nav_map_0" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_map_0" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_map_0" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_vote_nav_map_0" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_map_0" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_map_0" bordercolor .23 .29 .35 .75 ; }
 action { close ingame_vote_misc ; open ingame_vote ; close ingame_vote ; open ingame_vote_map }
cvarTest "authLevel" showCVar { RL_NONE } voteflag CV_SVF_MAP
            }
itemDef { name "modern_vote_nav_map_1" rect 544 12 138 30
                text "MAP" textfont UI_FONT_ARIBLK_27 textscale .25
                textalign ITEM_ALIGN_CENTER textalignx 69 textaligny 21
                style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL
                bordercolor .23 .29 .35 .75
                backcolor .08 .12 .16 1
                forecolor .84 .89 .94 1
                visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_vote_nav_map_1" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_map_1" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_map_1" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_vote_nav_map_1" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_map_1" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_map_1" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_vote_nav_map_1" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_map_1" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_map_1" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_vote_nav_map_1" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_map_1" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_map_1" bordercolor .23 .29 .35 .75 ; }
 action { close ingame_vote_misc ; open ingame_vote ; close ingame_vote ; open ingame_vote_map }
cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON }
            }
itemDef { name "modern_vote_nav_players_0" rect 690 12 138 30
                text "PLAYERS" textfont UI_FONT_ARIBLK_27 textscale .25
                textalign ITEM_ALIGN_CENTER textalignx 69 textaligny 21
                style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL
                bordercolor .23 .29 .35 .75
                backcolor .08 .12 .16 1
                forecolor .84 .89 .94 1
                visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_vote_nav_players_0" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_players_0" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_players_0" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_vote_nav_players_0" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_players_0" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_players_0" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_vote_nav_players_0" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_players_0" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_players_0" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_vote_nav_players_0" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_players_0" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_players_0" bordercolor .23 .29 .35 .75 ; }
 action { close ingame_vote_misc ; open ingame_vote ; close ingame_vote ; open ingame_vote_players }
cvarTest "authLevel" showCVar { RL_NONE } voteFlag $evalint(CV_SVF_KICK + CV_SVF_REFEREE + CV_SVF_MUTING)
            }
itemDef { name "modern_vote_nav_players_1" rect 690 12 138 30
                text "PLAYERS" textfont UI_FONT_ARIBLK_27 textscale .25
                textalign ITEM_ALIGN_CENTER textalignx 69 textaligny 21
                style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL
                bordercolor .23 .29 .35 .75
                backcolor .08 .12 .16 1
                forecolor .84 .89 .94 1
                visible 1 type ITEM_TYPE_BUTTON
mouseEnter { setitemcolor "modern_vote_nav_players_1" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_players_1" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_players_1" bordercolor .94 .75 .27 1 ; }
mouseExit { setitemcolor "modern_vote_nav_players_1" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_players_1" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_players_1" bordercolor .23 .29 .35 .75 ; }
onFocus { setitemcolor "modern_vote_nav_players_1" backcolor .19 .26 .33 1 ; setitemcolor "modern_vote_nav_players_1" forecolor 1 1 1 1 ; setitemcolor "modern_vote_nav_players_1" bordercolor .94 .75 .27 1 ; }
leaveFocus { setitemcolor "modern_vote_nav_players_1" backcolor .08 .12 .16 1 ; setitemcolor "modern_vote_nav_players_1" forecolor .84 .89 .94 1 ; setitemcolor "modern_vote_nav_players_1" bordercolor .23 .29 .35 .75 ; }
 action { close ingame_vote_misc ; open ingame_vote ; close ingame_vote ; open ingame_vote_players }
cvarTest "authLevel" showCVar { RL_REFEREE RL_RCON }
            }

}
