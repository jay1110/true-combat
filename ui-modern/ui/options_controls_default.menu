#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpControlsDefault"

// Macros //

#include "ui/modern_widgets.h"
		
// Controls Default Menu //
	
menuDef
{
	name		"options_controls_default"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.55
	fadeAmount  0.075
	
	onOpen
	{
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
	}
	
	onESC
	{
		close options_controls_default ;
		open options_controls
	}
	
// Background //

	itemDef {
		name		"background"
		rect		-5 -85 862 650
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 180
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 150

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "DEFAULT CONTROLS" )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+52, SUBWINDOW_WIDTH-48, 18, "Reset controls to default?", .26, ITEM_ALIGN_LEFT, 0, 15 )
	MULTI( SUBWINDOW_X+2, SUBWINDOW_Y+40, (SUBWINDOW_WIDTH)-8, 10, "Handedness:", .2, 8, "ui_handedness", cvarFloatList { "Right" 0 "Left" 1 }, "Left or Right Handed? This sets your default controls\nwhich you can modify later via the options menu" )
	
	BUTTON( SUBWINDOW_X+24, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "YES", .30, 21, close options_controls_default ; open options_controls ; uiScript defaultControls )
	BUTTON( SUBWINDOW_X+230, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "NO", .30, 21, close options_controls_default ; open options_controls )
    itemDef { name "modern_accent" rect 0 0 2 16 style WINDOW_STYLE_FILLED backcolor .94 .75 .27 .8 visible 1 decoration }
}
