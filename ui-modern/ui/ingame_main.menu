#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpIngameMain"

// Macros //

#include "ui/modern_widgets.h"

// Main Menu //

menuDef {
	name		"ingame_main"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onOpen {
		// ydnar
		conditionalscript ROldModeCheck 2
			( "clearFocus ; open vid_confirm" )
			( "clearFocus" )
	}
	
	onEsc {
		close ingame_main ;
	}
// Background //

	itemDef {
		name		"background"
		rect		-305 -237 862 650
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}
// Window //

	WINDOW( "Main Menu", 50 )
	
// Buttons //

	BUTTON( 24, 84, 256, 88, "Deployment", .37, 57, clearFocus ; close ingame_main ; exec OpenLimboMenu ; )


	BUTTONEXT( 298, 84, 256, 88, "Vote", .37, 57, uiScript clientCheckVote ; 
															conditionalScript cg_ui_novote 0
																( "clearFocus ; open ingame_votedisabled" )
																( "close ingame_main ; open ingame_vote" ), cvarTest "authLevel" showCVar { RL_NONE } )
	BUTTONEXT( 298, 84, 256, 88, "Referee", .37, 57, close ingame_main ; open ingame_vote, cvarTest "authLevel" showCVar { RL_REFEREE } )
	BUTTONEXT( 298, 84, 256, 88, "RCON", .37, 57, close ingame_main ; open ingame_vote, cvarTest "authLevel" showCVar { RL_RCON } )
	
	BUTTON( 572, 84, 256, 88, "Server Info", .37, 57, close ingame_main ; open ingame_serverinfo )
	BUTTON( 24, 192, 256, 88, "Options", .37, 57, close ingame_main ; open options )
	BUTTON( 298, 192, 256, 88, "Disconnect", .37, 57, clearFocus ; open ingame_disconnect )
	BUTTON( 572, 192, 256, 88, "Exit TC:E", .37, 57, clearFocus ; open quit )
	BUTTON( 24, 300, 256, 88, "Omni-bot Editor", .37, 57, close ingame_main ; open tce_omnibot )
}
