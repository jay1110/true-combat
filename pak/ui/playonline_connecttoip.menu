#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpPlayOnlineConnectToIP"

// Macros //

#include "ui/modern_widgets.h"
		
// Connect To IP Menu //
	
menuDef {
	name		"playonline_connecttoip"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	onOpen {
		setEditFocus "efleftServer IP:"
	}
	
	onESC {
		close playonline_connecttoip ;
		open playonline
	}
	
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 180
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 150

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "CONNECT TO IP" )
	
	itemDef {
		name		"efleftbackServer IP:"
		group		GROUP_NAME
		rect		284 216 340 28
		style		WINDOW_STYLE_FILLED
		backcolor	.075 .105 .14 .98
		visible		1
		decoration
		border	WINDOW_BORDER_FULL
		bordercolor	.35 .32 .22 .85
	}
	EDITFIELDLEFT( 228, 216, 396, 28, "Server IP:", .26, 20, "ui_connectToIPAddress", 32, 25, "Enter the IP address seperated by dots: xxx.xxx.xxx.xxx" )
	
	BUTTON( 228, 288, 190, 30, "BACK", .30, 21, close playonline_connecttoip ; open playonline )
	BUTTON( 434, 288, 190, 30, "CONNECT", .30, 21, conditionalscript ui_connectToIPAddress 1
																											( "uiScript JoinDirectServer" )
																											( "open playonline_connecttoip" ) )
}
