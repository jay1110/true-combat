#include "ui/menudef.h"

// Defines //
#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpHostgameDedicatedWarning"

// Macros //

#include "ui/modern_widgets.h"
		
// Dedicated Server Starting Warning Menu //
	
menuDef
{
	name		"hostgame_dedicated_warning"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	onESC
	{
		close hostgame_dedicated_warning ;
		open hostgame_sub
	}
	
// Background //

	itemDef {
		name		"background"
		rect		-111 -85 862 650
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}

// Subwindows //

#define SUBWINDOW_WIDTH 444
#define SUBWINDOW_HEIGHT 212
#define SUBWINDOW_X 204
#define SUBWINDOW_Y 134

	SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "START DEDICATED SERVER" )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+52, SUBWINDOW_WIDTH-48, 18, "Starting a Dedicated Server will", .26, ITEM_ALIGN_LEFT, 0, 15 )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+71, SUBWINDOW_WIDTH-48, 18, "close the game window and open the", .26, ITEM_ALIGN_LEFT, 0, 15 )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+90, SUBWINDOW_WIDTH-48, 18, "server console. It will not be possible", .26, ITEM_ALIGN_LEFT, 0, 15 )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+109, SUBWINDOW_WIDTH-48, 18, "to play the game on the host machine.", .26, ITEM_ALIGN_LEFT, 0, 15 )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+128, SUBWINDOW_WIDTH-48, 18, "Are you sure you want to start", .26, ITEM_ALIGN_LEFT, 0, 15 )
	LABEL( SUBWINDOW_X+24, SUBWINDOW_Y+147, SUBWINDOW_WIDTH-48, 18, "a Dedicated Server?", .26, ITEM_ALIGN_LEFT, 0, 15 )
	
	BUTTON( SUBWINDOW_X+24, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "YES", .30, 21, uiScript startServer )
	BUTTON( SUBWINDOW_X+230, SUBWINDOW_Y+SUBWINDOW_HEIGHT-42, 190, 30, "NO", .30, 21, close hostgame_dedicated_warning ; open hostgame_sub )
}
