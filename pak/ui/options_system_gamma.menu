#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpOptionsSystemGamma"

// Macros //

#include "ui/modern_widgets.h"
		
// System Menu //
	
menuDef {
	name		"options_system_gamma"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		close options_system_gamma ;
		fadeoutmenu background_black ;
#ifdef FUI
		open background_1 ;
#endif // FUI
		open options_system
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	.015 .025 .04 .72
		visible		1
		decoration
	}
// Window //

	WINDOW( "Calibrate Brightness", 214 )
    itemDef {
        name "modern_secondary_0"
        rect 24 170 390 222
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }

    itemDef {
        name "modern_secondary_1"
        rect 438 170 390 222
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }

	
// General

#define SUBWINDOW_WIDTH		WINDOW_WIDTH-12

	LABELWHITE( 24, 60, 804, 22, "Brightness Calibration", .28, ITEM_ALIGN_LEFT, 0, 17 )
	LABEL( 24, 90, 804, 18, "1. Move the slider below and/or the brightness on your monitor until you can see 16", .22, ITEM_ALIGN_LEFT, 0, 14 )
	LABEL( 24, 108, 804, 18, "     separate bars below of equal differing brightness. Use the upper bar if Dynamic Eye is disabled.", .22, ITEM_ALIGN_LEFT, 0, 14 )
	
	LABEL( 24, 126, 804, 18, "2. Make sure you can see 2 separate lines of text, the upper line should be hardly visible.", .22, ITEM_ALIGN_LEFT, 0, 14 )
	// LABEL( 6+2, 202+84, (WINDOW_WIDTH)-64, 10, "2. Adjust the slider until the upper line is hardly visible.", .2, ITEM_ALIGN_LEFT, 0, 8 )
	LABEL( 24, 144, 804, 18, "3. Click the BACK button.", .22, ITEM_ALIGN_LEFT, 0, 14 )
	
	
	LABELWHITE( 40, 186, 358, 24, "Dynamic Eye disabled", .28, ITEM_ALIGN_LEFT, 0, 17 )
	LABEL( 40, 214, 358, 18, "Typical values are 1.3 on a CRT and 1.0 on a TFT.", .22, ITEM_ALIGN_LEFT, 0, 14 )
	
	
	itemDef {
		name		"gammaBar"
		rect		40 248 358 32
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/gammabar16"
		forecolor	1 1 1 1
		border		WINDOW_BORDER_FULL
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}
	
	itemDef {
		name		"threesquares"
		rect		75 296 288 70
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/hardlyvisible"
		forecolor	1 1 1 1
		border		WINDOW_BORDER_FULL
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}
	
	
	LABELWHITE( 454, 186, 358, 24, "Dynamic Eye enabled", .28, ITEM_ALIGN_LEFT, 0, 17 )
	LABEL( 454, 214, 358, 18, "Typical values are 1.0 on a CRT and 0.8 on a TFT.", .22, ITEM_ALIGN_LEFT, 0, 14 )
	
	
	itemDef {
		name		"gammaBar"
		rect		454 248 358 32
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/gammabar16de"
		forecolor	1 1 1 1
		border		WINDOW_BORDER_FULL
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}
	
	itemDef {
		name		"threesquares"
		rect		489 296 288 70
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/hardlyvisiblede"
		forecolor	1 1 1 1
		border		WINDOW_BORDER_FULL
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}

	//SLIDER( 2, WINDOW_HEIGHT-18-6-12, WINDOW_WIDTH-4, 10, "Brightness:", .2, 8, "r_gamma" 1 0.7 1.4 )
	SLIDER( 236, 408, 320, 22, "Gamma:", .26, 16, "r_gamma" 1 0.6 1.6, "" )
	CVARFLOATLABEL( 568, 408, 148, 22, "r_gamma", .26, ITEM_ALIGN_RIGHT, 148, 16 )
	
