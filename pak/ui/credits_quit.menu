// Quit Credits Menu //
	
menuDef {
	name		"credits_quit"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		uiScript Quit;
	}
	
	

	onOpen {
		playlooped "sound/music/loopIntrotuned.wav"
	}

// Background //

	itemDef {
		name		"background"
