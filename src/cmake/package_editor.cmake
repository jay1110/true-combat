cmake_minimum_required(VERSION 3.20)
if(NOT OUTPUT_DIRECTORY)
  message(FATAL_ERROR "Set OUTPUT_DIRECTORY to a local authoring package directory")
endif()
get_filename_component(OUTPUT_DIRECTORY "${OUTPUT_DIRECTORY}" ABSOLUTE)
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
set(source "${CMAKE_CURRENT_LIST_DIR}/../tools/navstudio/editor-ui")
set(stage "${OUTPUT_DIRECTORY}/editor-stage")
file(MAKE_DIRECTORY "${stage}/ui")
set(entries)
file(STRINGS "${source}/editor-files.txt" editor_files)
foreach(name IN LISTS editor_files)
  if(NOT name MATCHES "^(tce_[A-Za-z0-9_]+\\.menu|wm_(ft)?quickmessage(Alt)?\\.menu|menus(_gt[257])?\\.txt)$" OR
     NOT EXISTS "${source}/${name}")
    message(FATAL_ERROR "Invalid or missing local editor asset: ${name}")
  endif()
  file(COPY "${source}/${name}" DESTINATION "${stage}/ui")
  list(APPEND entries "ui/${name}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUTPUT_DIRECTORY}/zz_tce2_navstudio_editor.pk3" --format=zip -- ${entries}
  WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Local authoring addon only; never upload this PK3 to a public server.")
