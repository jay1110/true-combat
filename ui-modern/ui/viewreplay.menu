#include "ui/menudef.h"

// Defines //

#define WINDOW_X 0
#define WINDOW_Y 0
#define WINDOW_WIDTH 852
#define WINDOW_HEIGHT 480
#define GROUP_NAME		"grpViewReplay"

// Macros //

#include "ui/modern_widgets.h"
		
// View tcemods Menu //
	
menuDef {
	name		"viewreplay"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.55
	fadeAmount  0.075
	
	onOpen {
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
		uiScript LoadDemos
	}
	
	onESC {
		close viewreplay ;
		open main
	}
	
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
		style		WINDOW_STYLE_FILLED
		background	"ui/assets/fadebox.tga"
		backcolor	0 0 0 0
		visible		1
		decoration
	}
// Window //

	WINDOW( "Replays", 150 )
    itemDef {
        name "modern_browse_card_0"
        rect 24 60 804 372
        style WINDOW_STYLE_FILLED
        backcolor .035 .055 .075 .94
        border WINDOW_BORDER_FULL
        bordercolor .18 .24 .29 .65
        visible 1
        decoration
    }


// Demo List //

	itemDef {
		name			"demoList"
		group			GROUP_NAME
		rect			36 76 780 340
		type			ITEM_TYPE_LISTBOX
		textfont		UI_FONT_COURBD_21
		textscale		.28
		textaligny		-2
		forecolor		.88 .91 .94 1
		outlinecolor	.94 .75 .27 .20
		border			WINDOW_BORDER_FULL
		bordercolor		.23 .29 .35 .75
		feeder			FEEDER_DEMOS
		elementtype		LISTBOX_TEXT
		elementwidth	764
		elementheight	28
		columns			1 0 764 33
		visible			1
		tooltip			"Select the replay to view or delete"
		
		doubleClick {
			uiScript RunDemo
		}
		backcolor	.055 .075 .10 .94
	}
	
// Buttons //

	BUTTON( 24, 442, 184, 28, "BACK", .27, 20, close viewreplay ; open main )
	BUTTON( 438, 442, 178, 28, "DELETE", .27, 20, conditionalScript ValidReplaySelected 2
																										( "clearFocus ; open viewreplay_delete" )
																										( "clearFocus" ) )
	BUTTON( 638, 442, 190, 28, "VIEW", .27, 20, uiScript RunDemo )
}
