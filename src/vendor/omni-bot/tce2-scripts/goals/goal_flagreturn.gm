// This script contains functionality to return flag (or radar parts, documents etc.) which were dropped by enemy
this.Name = "FLAGRETURN";
this.Parent = "HighLevel";
this.SkipGetPriorityWhenActive = true;

this.GetPriority = function()
{
	Util.GetPriority(this,0xa06840e5 /* FLAGRETURN */,0,0, function(goal, bot)
	{
		ent = goal.GetEntity();
		if(TCE2ItemContact && TCE2ItemContact.IsTCE(bot) && goal.GetGoalState()!=2) { return false; }
		return ent && bot.CanGrabItem(ent);
	});
};

this.Enter = function()
{
	if(!this.MarkInProgress() || !this.MarkInUse()) { this.Finished(); }
	if(TCE2ItemContact && TCE2ItemContact.IsTCE(this.Bot)) { return; }

	this.TargetPosition = this.MapGoal.GetPosition();
	this.DynamicGotoThread = this.ForkThread(this.DynamicGoto);
};

this.Exit = function()
{
	if(TCE2ItemContact) { TCE2ItemContact.Release(this); }
	if(this.DynamicGotoThread) { this.KillThread(this.DynamicGotoThread); }
};

this.DynamicGoto = function()
{
	if(this.Goto(this.TargetPosition,0) == EVENT.PATH_FAILED)
	{
		Util.PathFailed(this);
	}
	this.Finished();
};


this.Update = function()
{
	if(TCE2ItemContact && TCE2ItemContact.IsTCE(this.Bot)) { this.TCEReturn();return; }
	pos = this.MapGoal.GetPosition();
	if( DistanceBetween(pos,this.TargetPosition) > 100)
	{
		this.TargetPosition = pos;
		this.KillThread(this.DynamicGotoThread);
		this.DynamicGotoThread = this.ForkThread(this.DynamicGoto);
	}
};

// The native dynamic flag entity is an item, not a player-origin destination.
// Use the same capsule-checked contact construction as the typed item goal.
this.TCEReturn = function()
{
    if(this.MapGoal.GetGoalState()!=2) { this.Finished();return; }
    ent=this.MapGoal.GetEntity();
    if(!ent || !this.Bot.CanGrabItem(ent) || !TCE2ItemContact.Approach(this,ent))
    { this.BlackboardDelay(10);this.Finished();return; }
    deadline=GetTime()+2;
    while(GetTime()<deadline && this.MapGoal.GetGoalState()==2)
    {
        bounds=TCE2ItemContact.Bounds(ent);
        if(!bounds || !this.Bot.CanGrabItem(ent) || !TCE2ItemContact.CheckedPose(this.Bot,bounds)) { break; }
        this.Bot.HoldButton(BTN.USE,0.2);this.TCEUseHeld=true;
        sleep(0.1);
    }
    TCE2ItemContact.Release(this);
    state=this.MapGoal.GetGoalState();
    if(state==1) { TCE2ItemContact.Log(this,"RETURN_STATE_OBSERVED"); }
    else if(state==2) { TCE2ItemContact.Log(this,"RETURN_NOT_CONFIRMED");this.BlackboardDelay(10); }
    else { TCE2ItemContact.Log(this,"FLAG_STATE_CHANGED"); }
    // A deleted dropped entity may also mean an enemy picked it up. Never
    // attribute a return to this bot from disappearance or elapsed time alone.
    this.Finished();
};
