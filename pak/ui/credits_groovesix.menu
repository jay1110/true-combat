// Macros //

#include "ui/modern_widgets.h"
		
// System Menu //
	
menuDef {
	name		"credits_groovesix"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	popup
	
	fadeClamp	0.55
	fadeAmount  0.075
	
	onOpen {
		
		setitemcolor background backcolor 0 0 0 0 ;
		fadein background
	}

	onESC {
		close credits_groovesix ;
		open main
	}
// Background //

	itemDef {
		name		"background"
		rect		0 0 852 480
